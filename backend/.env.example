# 应用配置
APP_NAME=cloudcoupon-api
APP_HOST=0.0.0.0
APP_PORT=8898
APP_ENV=dev
ADMIN_SETUP_TOKEN=your_admin_setup_token

# JWT配置
JWT_ACCESS_SECRET=cloudcoupon-jwt-access-secret-key-2023
JWT_ACCESS_EXPIRE=86400
JWT_REFRESH_EXPIRE=604800

# MySQL配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Root%123456
MYSQL_DATABASE=cloudcoupon

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 阿里云短信配置
ALI_SMS_ACCESS_KEY_ID=your_access_key_id
ALI_SMS_ACCESS_KEY_SECRET=your_access_key_secret
ALI_SMS_SIGN_NAME=your_sign_name
ALI_SMS_TEMPLATE_CODE=your_template_code
ALI_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 七牛云OSS配置
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_bucket_name
QINIU_PUBLIC_DOMAIN=https://your_cdn_domain.com
QINIU_UPLOAD_URL=https://up-z2.qiniup.com

# ======================
# 支付配置
# ======================

# 支付宝支付配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_PUBLIC_CERT=
ALIPAY_APP_CERT=
ALIPAY_ROOT_CERT=
ALIPAY_NOTIFY_URL=https://api-tunnel.kekemate.com/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://api-tunnel.kekemate.com/payment/return
ALIPAY_IS_PROD=false
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_USE_CERT=false

# 微信支付配置
WECHAT_APP_ID=0
WECHAT_MCH_ID=0
WECHAT_API_KEY=your_wechat_api_key
WECHAT_SERIAL_NO=your_wechat_serial_no
WECHAT_API_V3_KEY=your_wechat_api_v3_key
WECHAT_PRIVATE_KEY=your_wechat_private_key
WECHAT_NOTIFY_URL=https://api-tunnel.kekemate.com/api/payment/wechat/notify
WECHAT_IS_PROD=false
WECHAT_USE_CERT=false

# 微信小程序登录配置
WECHAT_MINI_PROGRAM_APP_ID=your_wechat_mini_program_app_id
WECHAT_MINI_PROGRAM_APP_SECRET=your_wechat_mini_program_app_secret
WECHAT_MINI_MESSAGE_PUSH_TOKEN=your_wechat_mini_message_push_token
WECHAT_MINI_MESSAGE_PUSH_ENCODING_AES_KEY=your_wechat_mini_message_push_encoding_aes_key

# UNIPUSH
UNIPUSH_APP_ID=
UNIPUSH_APP_KEY=
UNIPUSH_MASTER_SECRET=
