type GetSeasonReportReq {
	SeasonId int64 `form:"season_id"`
	GameType int   `form:"game_type,optional,default=3"`
}

type SeasonReportData {
	Record          *SeasonRecordInfo `json:"record"`
	RankTrend       []int             `json:"rank_trend"`
	WinRateByType   map[string]int    `json:"win_rate_by_type,omitempty"`
	TopAchievements []AchievementDef  `json:"top_achievements"`
}

type GetSeasonReportResp {
