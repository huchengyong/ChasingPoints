// 赛事需登录接口
type CreateTournamentReq {
	Name        string `json:"name"`
	Description string `json:"description,optional"`
	GameType    int    `json:"game_type"`
	Format      int    `json:"format"`
	MaxPlayers  int    `json:"max_players"`
	City        string `json:"city,optional"`
	VenueName   string `json:"venue_name,optional"`
	StartTime   string `json:"start_time"`
}

type CreateTournamentResp {
	Success      bool  `json:"success"`
	TournamentId int64 `json:"tournament_id"`
}

type TournamentIdReq {
	TournamentId int64 `json:"tournament_id"`
}

type UpdateTournamentMatchReq {
	TournamentMatchId int64 `json:"tournament_match_id"`
	WinnerId          int64 `json:"winner_id"`
	MatchId           int64 `json:"match_id,optional"`
}

type GetMyTournamentsReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
	Status   int `form:"status,optional"`
}

@server (
	prefix: /api/tournament
	group:  tournament
	jwt:    Auth
)
service chasing_points-api {
	@doc "创建赛事"
	@handler CreateTournament
	post /create (CreateTournamentReq) returns (CreateTournamentResp)

	@doc "报名赛事"
	@handler JoinTournament
	post /join (TournamentIdReq) returns (CommonResp)

	@doc "退出赛事"
	@handler LeaveTournament
	post /leave (TournamentIdReq) returns (CommonResp)

	@doc "签到赛事"
	@handler CheckinTournament
	post /checkin (TournamentIdReq) returns (CommonResp)

	@doc "更新赛事对局结果"
	@handler UpdateTournamentMatch
	post /match/update (UpdateTournamentMatchReq) returns (CommonResp)

	@doc "结束赛事"
	@handler FinishTournament
	post /finish (TournamentIdReq) returns (CommonResp)

	@doc "取消赛事"
	@handler CancelTournament
	post /cancel (TournamentIdReq) returns (CommonResp)

	@doc "获取我的赛事"
	@handler GetMyTournaments
	get /my (GetMyTournamentsReq) returns (GetTournamentListResp)
}

