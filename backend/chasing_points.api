	@doc "获取赛事分享数据"
	@handler GetTournamentShareData
	get /tournament (GetTournamentShareDataReq) returns (GetTournamentShareDataResp)
}

// ==================== 竞技分析模块 ====================
type GameTypeStats {
	GameType     int     `json:"game_type"`
	GameTypeName string  `json:"game_type_name"`
	TotalMatches int     `json:"total_matches"`
	Wins         int     `json:"wins"`
	Losses       int     `json:"losses"`
	WinRate      float64 `json:"win_rate"`
	HighestScore int     `json:"highest_score"`
}

type TrendPoint {
	MatchId   int64   `json:"match_id"`
	Date      string  `json:"date"`
	WinRate   float64 `json:"win_rate"`
	RankScore int     `json:"rank_score,omitempty"`
	Result    int     `json:"result"`
}

type SingleHighScoreRecord {
	MatchId      int64  `json:"match_id"`
	Score        int    `json:"score"`
	GameType     int    `json:"game_type"`
	GameTypeName string `json:"game_type_name"`
	OpponentName string `json:"opponent_name"`
	Date         string `json:"date"`
}

type DurationStats {
	AverageSeconds int `json:"average_seconds"`
	FastestSeconds int `json:"fastest_seconds"`
	LongestSeconds int `json:"longest_seconds"`
	TotalMatches   int `json:"total_matches"`
}

type OpponentStrengthItem {
	RankRange string  `json:"rank_range"`
	Matches   int     `json:"matches"`
	Wins      int     `json:"wins"`
	WinRate   float64 `json:"win_rate"`
}

type GetStatsByGameTypeResp {
	Success bool            `json:"success"`
	List    []GameTypeStats `json:"list"`
}

type GetRecentTrendReq {
	Limit    int `form:"limit,optional,default=30"`
	GameType int `form:"game_type,optional"`
}

type GetRecentTrendResp {
	Success bool         `json:"success"`
	List    []TrendPoint `json:"list"`
}

type GetRankScoreTrendReq {
	Limit    int `form:"limit,optional,default=30"`
	GameType int `form:"game_type,optional,default=3"`
}

type GetRankScoreTrendResp {
	Success bool         `json:"success"`
	List    []TrendPoint `json:"list"`
}

type GetSingleHighScoreReq {
	GameType int `form:"game_type,optional"`
	Limit    int `form:"limit,optional,default=10"`
}

type GetSingleHighScoreResp {
	Success bool                    `json:"success"`
	List    []SingleHighScoreRecord `json:"list"`
}

type GetMatchDurationStatsReq {
	GameType int `form:"game_type,optional"`
}

type GetMatchDurationStatsResp {
	Success bool           `json:"success"`
	Stats   *DurationStats `json:"stats"`
}

type GetOpponentStrengthResp {
	Success bool                   `json:"success"`
	List    []OpponentStrengthItem `json:"list"`
}

type GetOpponentStrengthReq {
	GameType int `form:"game_type,optional"`
}

@server (
	prefix: /api/stats
	group:  stats
	jwt:    Auth
)
service chasing_points-api {
	@doc "分球种统计"
	@handler GetStatsByGameType
	get /by-game-type returns (GetStatsByGameTypeResp)

	@doc "近N场胜率趋势"
	@handler GetRecentTrend
	get /recent-trend (GetRecentTrendReq) returns (GetRecentTrendResp)

	@doc "段位分变化趋势"
	@handler GetRankScoreTrend
	get /rank-score-trend (GetRankScoreTrendReq) returns (GetRankScoreTrendResp)

	@doc "单杆最高分记录"
	@handler GetSingleHighScore
	get /single-high-score (GetSingleHighScoreReq) returns (GetSingleHighScoreResp)

	@doc "对局时长统计"
	@handler GetMatchDurationStats
	get /match-duration (GetMatchDurationStatsReq) returns (GetMatchDurationStatsResp)

	@doc "强弱对手分析"
	@handler GetOpponentStrength
	get /opponent-strength (GetOpponentStrengthReq) returns (GetOpponentStrengthResp)
}

// ==================== Admin 管理后台 ====================
type AdminLoginReq {
	Email    string `json:"email"`
	Password string `json:"password"`
}

type AdminLoginResp {
	Code     int        `json:"code"`
	Success  bool       `json:"success"`
	Message  string     `json:"message"`
	Token    string     `json:"token"`
	UserInfo *AdminInfo `json:"userInfo"`
}

type AdminInfo {
	Id       int64  `json:"id"`
	Email    string `json:"email"`
	Nickname string `json:"nickname"`
	Avatar   string `json:"avatar"`
	Role     string `json:"role"`
}

type AdminInitReq {
	Email      string `json:"email"`
	Password   string `json:"password"`
	SetupToken string `json:"setup_token"`
}

type AdminInitResp {
	Code    int    `json:"code"`
	Success bool   `json:"success"`
	Message string `json:"message"`
}

type AdminChangePasswordReq {
	OldPassword string `json:"old_password"`
	NewPassword string `json:"new_password"`
}

type AdminWriteResp {
	Code         int    `json:"code"`
	Success      bool   `json:"success"`
	Message      string `json:"message"`
	EventId      int64  `json:"event_id,optional"`
	TournamentId int64  `json:"tournament_id,optional"`
}

type AdminUserInfoResp {
	Code     int        `json:"code"`
	Success  bool       `json:"success"`
	Message  string     `json:"message"`
	UserInfo *AdminInfo `json:"userInfo"`
}

type AdminExistsResp {
	Code    int    `json:"code"`
	Success bool   `json:"success"`
	Message string `json:"message"`
	Exists  bool   `json:"exists"`
}

@server (
	prefix: /api/admin
	group:  admin
)
service chasing_points-api {
	@doc "管理员登录"
	@handler AdminLogin
	post /login (AdminLoginReq) returns (AdminLoginResp)

	@doc "初始化管理员账号"
	@handler AdminInit
	post /init (AdminInitReq) returns (AdminInitResp)

	@doc "检查管理员账号是否存在"
	@handler AdminExists
	get /exists returns (AdminExistsResp)
}

@server (
	prefix: /api/admin/user
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取当前管理员信息"
	@handler AdminUserInfo
	get /info returns (AdminUserInfoResp)

	@doc "修改管理员密码"
	@handler AdminChangePassword
	post /change-password (AdminChangePasswordReq) returns (AdminWriteResp)
}

