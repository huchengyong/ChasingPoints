	Desc  string `json:"desc,optional"`
	Icon  string `json:"icon,optional"`
	Tone  string `json:"tone,optional"`
}

type MatchDetailData {
	Id                            int64              `json:"id"`
	Player1Id                     int64              `json:"player1_id"`
	Player2Id                     int64              `json:"player2_id"`
	OpponentId                    int64              `json:"opponent_id,optional"`
	GameType                      int                `json:"game_type"`
	MatchMode                     string             `json:"match_mode,optional"`
	Visibility                    string             `json:"visibility,optional"`
	FinishState                   string             `json:"finish_state,optional"`
	FinishRequestedBy             int64              `json:"finish_requested_by,optional"`
	Status                        int                `json:"status"` // 1=进行中 2=已完成 3=已取消
	ServerRevision                int64              `json:"server_revision"`
	IsPlayer1                     bool               `json:"is_player1"` // 当前用户是否是创建者(用于视角判断)
	ViewerRole                    string             `json:"viewer_role,optional"`
	RefereeBound                  bool               `json:"referee_bound,optional"`
	RefereeUserId                 int64              `json:"referee_user_id,optional"`
	RefereeName                   string             `json:"referee_name,optional"`
	RefereeAvatar                 string             `json:"referee_avatar,optional"`
	RefereeJoinedAt               string             `json:"referee_joined_at,optional"`
	RefereeDurationSeconds        int64              `json:"referee_duration_seconds,optional"`
	CompletedByUserId             int64              `json:"completed_by_user_id,optional"`
	CompletionSource              string             `json:"completion_source,optional"`
	CanScore                      bool               `json:"can_score,optional"`
	CanUndo                       bool               `json:"can_undo,optional"`
	CanFinish                     bool               `json:"can_finish,optional"`
	CanRequestFinish              bool               `json:"can_request_finish,optional"`
	CanConfirmFinish              bool               `json:"can_confirm_finish,optional"`
	CanDisputeFinish              bool               `json:"can_dispute_finish,optional"`
	CanWithdrawFinish             bool               `json:"can_withdraw_finish,optional"`
	LastAction                    *MatchLastAction   `json:"last_action,optional"`
	MyScore                       int                `json:"my_score"` // 从当前用户视角的分数
	OpponentScore                 int                `json:"opponent_score"` // 从当前用户视角的对手分数
	MyName                        string             `json:"my_name"`
	OpponentName                  string             `json:"opponent_name"`
	MyAvatar                      string             `json:"my_avatar"`
	OpponentAvatar                string             `json:"opponent_avatar"`
	MyWinRate                     float64            `json:"my_win_rate"` // 我方胜率(百分比)
	OpponentWinRate               float64            `json:"opponent_win_rate"` // 对手胜率(百分比)
	MyMaxScore                    int                `json:"my_max_score"` // 我方单杆最高
	OpponentMaxScore              int                `json:"opponent_max_score"` // 对手单杆最高
	MyRankChange                  int                `json:"my_rank_change"`
	OpponentRankChange            int                `json:"opponent_rank_change"`
	MyRankDetails                 []RankDetail       `json:"my_rank_details"`
	CurrentFrameStarted           bool               `json:"current_frame_started,optional"`
	CurrentFrameMyScore           int                `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore     int                `json:"current_frame_opponent_score,optional"`
	RedBallCount                  int                `json:"red_ball_count,optional"`
	SnookerClearanceStarted       bool               `json:"snooker_clearance_started,optional"`
	SnookerClearedColors          []int              `json:"snooker_cleared_colors,optional"`
	SnookerExpectedClearanceScore int                `json:"snooker_expected_clearance_score,optional"`
	SnookerClearanceCompleted     bool               `json:"snooker_clearance_completed,optional"`
	SnookerRulesVersion           int                `json:"snooker_rules_version,optional"`
	BestOfFrames                  int                `json:"best_of_frames,optional"`
	StartingActor                 int                `json:"starting_actor,optional"`
	SnookerPhase                  string             `json:"snooker_phase,optional"`
	SnookerBallOn                 string             `json:"snooker_ball_on,optional"`
	SnookerStriker                int                `json:"snooker_striker,optional"`
	SnookerVisitNo                int                `json:"snooker_visit_no,optional"`
	SnookerCurrentBreak           int                `json:"snooker_current_break,optional"`
	SnookerRedsRemaining          int                `json:"snooker_reds_remaining,optional"`
	SnookerFreeBallAvailable      bool               `json:"snooker_free_ball_available,optional"`
	SnookerCueBallInHand          bool               `json:"snooker_cue_ball_in_hand,optional"`
	SnookerMissWarningActive      bool               `json:"snooker_miss_warning_active,optional"`
	SnookerRespottedBlackPending  bool               `json:"snooker_respotted_black_pending,optional"`
	SnookerPendingConcessionActor int                `json:"snooker_pending_concession_actor,optional"`
	SnookerPendingConcessionScope string             `json:"snooker_pending_concession_scope,optional"`
	SnookerFrameEndReason         string             `json:"snooker_frame_end_reason,optional"`
	SummaryHighlights             []MatchSummaryItem `json:"summary_highlights,optional"`
	SummaryStats                  []MatchSummaryItem `json:"summary_stats,optional"`
	Achievements                  MatchAchievement   `json:"achievements"`
	CreatedAt                     string             `json:"created_at"`
}

type GetMatchRewardSummaryReq {
	MatchId int64 `form:"match_id"`
}

type MatchRewardItem {
	AchievementId   int64  `json:"achievement_id"`
	AchievementKey  string `json:"achievement_key"`
	AchievementName string `json:"achievement_name"`
	Description     string `json:"description"`
	Icon            string `json:"icon"`
	RewardTitleId   int64  `json:"reward_title_id,optional"`
	RewardTitleName string `json:"reward_title_name,optional"`
	UnlockedAt      string `json:"unlocked_at"`
}

type GetMatchRewardSummaryResp {
	Success bool              `json:"success"`
	Status  string            `json:"status"`
	Message string            `json:"message,optional"`
	List    []MatchRewardItem `json:"list"`
}

@server (
	prefix: /api/match
	group:  match
	jwt:    Auth
)
service chasing_points-api {
	@doc "开始对局"
	@handler StartMatch
	post /start (StartMatchReq) returns (StartMatchResp)

	@doc "加分"
	@handler MatchScore
	post /score (MatchScoreReq) returns (MatchScoreResp)

	@doc "结束一局"
	@handler EndRound
	post /round/end (EndRoundReq) returns (EndRoundResp)

	@doc "开始下一局"
	@handler StartNextRound
	post /round/start (StartNextRoundReq) returns (StartNextRoundResp)

	@doc "犯规"
	@handler MatchFoul
	post /foul (MatchFoulReq) returns (MatchScoreResp)

	@doc "记录斯诺克击球结果"
	@handler SnookerStroke
	post /snooker/stroke (SnookerStrokeReq) returns (SnookerActionResp)

	@doc "记录斯诺克局级动作"
	@handler SnookerFrameAction
	post /snooker/frame-action (SnookerFrameActionReq) returns (SnookerActionResp)

	@doc "撤销操作"
	@handler MatchUndo
	post /undo (MatchUndoReq) returns (MatchUndoResp)

	@doc "结束对局"
	@handler FinishMatch
	post /finish (FinishMatchReq) returns (FinishMatchResp)

	@doc "获取本场新解锁荣誉"
	@handler GetMatchRewardSummary
	get /reward-summary (GetMatchRewardSummaryReq) returns (GetMatchRewardSummaryResp)

	@doc "发起排位结束确认"
	@handler RequestFinishMatch
	post /finish/request (FinishMatchActionReq) returns (FinishMatchActionResp)

	@doc "确认排位结束请求"
	@handler ConfirmFinishMatch
	post /finish/confirm (FinishMatchActionReq) returns (FinishMatchActionResp)

	@doc "对排位结束请求提出异议"
	@handler DisputeFinishMatch
	post /finish/dispute (FinishMatchActionReq) returns (FinishMatchActionResp)

	@doc "撤回排位结束请求"
	@handler WithdrawFinishMatch
	post /finish/withdraw (FinishMatchActionReq) returns (FinishMatchActionResp)

	@doc "取消对局"
	@handler CancelMatch
	post /cancel (CancelMatchReq) returns (CommonResp)

	@doc "获取进行中对局"
	@handler GetCurrentMatch
	get /current returns (GetCurrentMatchResp)

	@doc "获取对局列表"
	@handler GetMatchList
	get /list (MatchListReq) returns (MatchListResp)

	@doc "获取交锋统计"
	@handler GetH2HStats
	get /h2h/stats (H2HStatsReq) returns (H2HStatsResp)

	@doc "获取交锋历史"
	@handler GetH2HHistory
	get /h2h/history (H2HHistoryReq) returns (H2HHistoryResp)

	@doc "获取匹配二维码"
	@handler GetMatchQRCode
	get /qrcode returns (GetMatchQRCodeResp)

	@doc "获取本场裁判二维码"
	@handler GetMatchRefereeQRCode
	get /referee/qrcode (GetMatchRefereeQRCodeReq) returns (GetMatchRefereeQRCodeResp)

	@doc "裁判码预览"
	@handler RefereePreview
	post /referee/preview (RefereePreviewReq) returns (RefereePreviewResp)

	@doc "扫码加入并担任本场裁判"
	@handler JoinMatchReferee
	post /referee/join (JoinMatchRefereeReq) returns (JoinMatchRefereeResp)

	@doc "获取裁判历史"
	@handler GetRefereeHistory
	get /referee/history (RefereeHistoryReq) returns (RefereeHistoryResp)

	@doc "获取对局详情"
	@handler GetMatchDetail
	get /detail (GetMatchDetailReq) returns (GetMatchDetailResp)
}

// 对手记录列表项
type OpponentRecordItem {
	Id           int64   `json:"id"`
	Name         string  `json:"name"`
	Avatar       string  `json:"avatar"`
	TotalMatches int     `json:"total_matches"` // 总对局数
	Wins         int     `json:"wins"` // 我方胜场
	Losses       int     `json:"losses"` // 我方负场
	WinRate      float64 `json:"win_rate"` // 胜率百分比
	LastMatchAt  string  `json:"last_match_at"` // 上次对局时间
}

// 获取对手列表请求
type GetOpponentListReq {
	Page         int    `form:"page,default=1"`
	PageSize     int    `form:"page_size,default=20"`
	Keyword      string `form:"keyword,optional"`
	TargetUserId int64  `form:"target_user_id,optional"`
}

// 获取对手列表响应
type GetOpponentListResp {
	Success        bool                 `json:"success"`
	Message        string               `json:"message,optional"`
	Hidden         bool                 `json:"hidden"`
	TotalOpponents int                  `json:"total_opponents"` // 总对手数
	TotalWins      int                  `json:"total_wins"` // 总胜场
	Total          int64                `json:"total"`
	List           []OpponentRecordItem `json:"list"`
}

@server (
	prefix: /api/opponent
	group:  opponent
	jwt:    Auth
)
service chasing_points-api {
	@doc "搜索对手"
	@handler SearchOpponent
	get /search (SearchOpponentReq) returns (SearchOpponentResp)

	@doc (
		summary:     "获取对手列表"
		description: "获取当前用户交战过的所有对手列表及统计数据"
	)
	@handler GetOpponentList
	get /list (GetOpponentListReq) returns (GetOpponentListResp)
}

// ==================== 段位相关 ====================
// 段位信息
type RankInfo {
	Level       int    `json:"level"` // 段位等级 1-6
	Name        string `json:"name"` // 段位名称
	Icon        string `json:"icon"` // 段位图标URL
	RankScore   int    `json:"rank_score"` // 当前排位分
	TotalWins   int    `json:"total_wins"` // 总胜场
	TotalLosses int    `json:"total_losses"` // 总败场
	MaxStreak   int    `json:"max_streak"` // 最高连胜
	NextLevel   int    `json:"next_level"` // 下一段位等级
	NextName    string `json:"next_name"` // 下一段位名称
	NextScore   int    `json:"next_score"` // 晋级所需分数
	Progress    int    `json:"progress"` // 晋级进度百分比
}

// 获取用户段位信息
type GetUserRankInfoReq {
	GameType int `form:"game_type,optional,default=3"`
}

type GetUserRankInfoResp {
	Success  bool      `json:"success"`
	RankInfo *RankInfo `json:"rank_info"`
}

// 获取用户全部球种段位信息
type UserRankInfoItem {
	GameType int       `json:"game_type"`
	RankInfo *RankInfo `json:"rank_info"`
}

type GetUserRankInfosResp {
	Success   bool               `json:"success"`
	RankInfos []UserRankInfoItem `json:"rank_infos"`
}

// 段位列表项
type RankItem {
	Level     int    `json:"level"`
	Name      string `json:"name"`
	Icon      string `json:"icon"`
	MinScore  int    `json:"min_score"` // 晋升最低分
	IsCurrent bool   `json:"is_current"` // 是否当前段位
}

// 获取段位列表
type GetRankListReq {
	GameType int `form:"game_type,optional,default=3"`
}

type GetRankListResp {
	Success bool       `json:"success"`
	List    []RankItem `json:"list"`
}

// 排行榜用户项
type LeaderboardItem {
	Rank      int    `json:"rank"` // 排名
	UserId    int64  `json:"user_id"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	RankLevel int    `json:"rank_level"` // 段位等级
	RankName  string `json:"rank_name"` // 段位名称
	RankScore int    `json:"rank_score"` // 排位分
	WinRate   int    `json:"win_rate"` // 胜率百分比
}

// 获取排行榜请求
type GetLeaderboardReq {
	GameType int `form:"game_type,optional,default=3"`
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

// 获取排行榜响应
type GetLeaderboardResp {
	Success   bool              `json:"success"`
	Total     int64             `json:"total"`
	TopThree  []LeaderboardItem `json:"top_three"` // 前三名
	MyRanking *LeaderboardItem  `json:"my_ranking"` // 我的排名
	List      []LeaderboardItem `json:"list"` // 第4名开始的列表
}

@server (
	prefix: /api/rank
	group:  rank
	jwt:    Auth
)
service chasing_points-api {
	@doc (
		summary:     "获取用户段位信息"
		description: "获取当前登录用户的段位信息，包括段位等级、排位分和晋级进度"
	)
	@handler GetUserRankInfo
	get /info (GetUserRankInfoReq) returns (GetUserRankInfoResp)

	@doc (
		summary:     "获取用户全部球种段位信息"
		description: "获取当前登录用户四种支持球种的段位信息"
	)
	@handler GetUserRankInfos
	get /infos returns (GetUserRankInfosResp)

	@doc (
		summary:     "获取段位列表"
		description: "获取所有段位列表及其晋升条件"
	)
	@handler GetRankList
	get /list (GetRankListReq) returns (GetRankListResp)
}

// ==================== 成就模块 ====================
// 成就定义
type AchievementDef {
	Id              int64  `json:"id"`
	Key             string `json:"key"`
	Name            string `json:"name"`
	Description     string `json:"description"`
	Icon            string `json:"icon"`
	Category        string `json:"category"`
	GameType        int    `json:"game_type"`
	RewardTitleName string `json:"reward_title_name,optional"`
	Threshold       int    `json:"threshold"`
	Progress        int    `json:"progress"`
	Unlocked        bool   `json:"unlocked"`
	UnlockedAt      string `json:"unlocked_at,omitempty"`
}

type GetAchievementListReq {
	Category string `form:"category,optional"`
}

type GetAchievementListResp {
	Success bool             `json:"success"`
	List    []AchievementDef `json:"list"`
}

type GetUserAchievementsResp {
	Success bool             `json:"success"`
	Total   int              `json:"total"`
	List    []AchievementDef `json:"list"`
}

// 称号
type TitleInfo {
	Id            int64  `json:"id"`
	TitleName     string `json:"title_name"`
	Source        string `json:"source"`
	SourceType    string `json:"source_type,optional"`
	SourceRefId   int64  `json:"source_ref_id,optional"`
	SourceRefName string `json:"source_ref_name,optional"`
	Equipped      bool   `json:"equipped"`
	GrantedAt     string `json:"granted_at,optional"`
	CreatedAt     string `json:"created_at"`
}

type EquipTitleReq {
	TitleId int64 `json:"title_id"`
	Equip   bool  `json:"equip"`
}

type GetUserTitlesResp {
	Success bool        `json:"success"`
	List    []TitleInfo `json:"list"`
}

type GetHonorWallReq {
	UserId          int64 `form:"user_id,optional"`
	GameType        int   `form:"game_type,optional,default=3"`
	HistorySeasonId int64 `form:"history_season_id,optional"`
	HistoryPage     int   `form:"history_page,optional,default=1"`
	HistoryPageSize int   `form:"history_page_size,optional,default=20"`
}

type HonorWallProfile {
	UserId   int64  `json:"user_id"`
	Nickname string `json:"nickname"`
	Avatar   string `json:"avatar"`
}

type HonorWallSummary {
	CareerUnlocked    int `json:"career_unlocked"`
	CareerTotal       int `json:"career_total"`
	UniversalUnlocked int `json:"universal_unlocked"`
	UniversalTotal    int `json:"universal_total"`
	SpecialtyGameType int `json:"specialty_game_type"`
	SpecialtyUnlocked int `json:"specialty_unlocked"`
	SpecialtyTotal    int `json:"specialty_total"`
	SeasonHonors      int `json:"season_honors"`
	TournamentHonors  int `json:"tournament_honors"`
}

type HonorItem {
	Id              int64  `json:"id"`
	Type            string `json:"type"`
	Name            string `json:"name"`
	Description     string `json:"description,optional"`
	Icon            string `json:"icon,optional"`
	SourceType      string `json:"source_type"`
	SourceRefId     int64  `json:"source_ref_id,optional"`
	SourceRefName   string `json:"source_ref_name,optional"`
	RewardTitleName string `json:"reward_title_name,optional"`
	EarnedAt        string `json:"earned_at"`
}

type SeasonChallengeInfo {
	Key         string `json:"key"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Threshold   int    `json:"threshold"`
	Progress    int    `json:"progress"`
	Completed   bool   `json:"completed"`
}

type HonorWallSeasonInfo {
	SeasonId   int64                 `json:"season_id"`
	SeasonName string                `json:"season_name"`
	StartDate  string                `json:"start_date"`
	EndDate    string                `json:"end_date"`
	Status     int                   `json:"status"`
	GameType   int                   `json:"game_type"`
	Challenges []SeasonChallengeInfo `json:"challenges"`
}

type HonorWallHistory {
	Total            int64                 `json:"total"`
	Honors           []HonorItem           `json:"honors"`
	ChallengeSeason  *HonorWallSeasonInfo  `json:"challenge_season,optional"`
	ChallengeRecords []SeasonChallengeInfo `json:"challenge_records"`
}

type GetHonorWallResp {
	Success            bool                 `json:"success"`
	ViewerScope        string               `json:"viewer_scope"`
	Profile            HonorWallProfile     `json:"profile"`
	EquippedTitle      *TitleInfo           `json:"equipped_title,optional"`
	Summary            HonorWallSummary     `json:"summary"`
	RecentHonors       []HonorItem          `json:"recent_honors"`
	CareerAchievements []AchievementDef     `json:"career_achievements"`
	CurrentSeason      *HonorWallSeasonInfo `json:"current_season,optional"`
	History            HonorWallHistory     `json:"history"`
}

@server (
	prefix: /api/achievement
	group:  achievement
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取成就列表"
	@handler GetAchievementList
	get /list (GetAchievementListReq) returns (GetAchievementListResp)

	@doc "获取已解锁成就"
	@handler GetUserAchievements
	get /unlocked returns (GetUserAchievementsResp)

	@doc "装备/卸下称号"
	@handler EquipTitle
	post /title/equip (EquipTitleReq) returns (CommonResp)

	@doc "获取用户称号列表"
	@handler GetUserTitles
	get /titles returns (GetUserTitlesResp)

	@doc "获取本人或好友荣誉墙"
	@handler GetHonorWall
	get /honor-wall (GetHonorWallReq) returns (GetHonorWallResp)
}

// ==================== 好友模块 ====================
type FriendInfo {
	Id        int64  `json:"id"`
	UserId    int64  `json:"user_id"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	RankLevel int    `json:"rank_level"`
	RankName  string `json:"rank_name"`
	CreatedAt string `json:"created_at"`
}

type FriendRequestInfo {
	Id         int64  `json:"id"`
	FromUserId int64  `json:"from_user_id"`
	Nickname   string `json:"nickname"`
	Avatar     string `json:"avatar"`
	Message    string `json:"message"`
	Status     int    `json:"status"`
	CreatedAt  string `json:"created_at"`
}

type SendFriendRequestReq {
	ToUserId int64  `json:"to_user_id"`
	Message  string `json:"message,optional"`
}

type HandleFriendRequestReq {
	RequestId int64 `json:"request_id"`
}

type GetFriendListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Keyword  string `form:"keyword,optional"`
}

type GetFriendListResp {
	Success bool         `json:"success"`
	Total   int64        `json:"total"`
	List    []FriendInfo `json:"list"`
}

type DeleteFriendReq {
	FriendUserId int64 `json:"friend_user_id"`
}

type BlacklistFriendReq {
	FriendUserId int64 `json:"friend_user_id"`
}

type GetFriendRequestsReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

type GetFriendRequestsResp {
	Success bool                `json:"success"`
	Total   int64               `json:"total"`
	List    []FriendRequestInfo `json:"list"`
}

type SearchUserReq {
	Keyword string `form:"keyword"`
}

type SearchUserItem {
	UserId   int64  `json:"user_id"`
	Nickname string `json:"nickname"`
	Avatar   string `json:"avatar"`
	RankName string `json:"rank_name"`
	IsFriend bool   `json:"is_friend"`
}

type SearchUserResp {
	Success bool             `json:"success"`
	List    []SearchUserItem `json:"list"`
}

@server (
	prefix: /api/friend
	group:  friend
	jwt:    Auth
)
service chasing_points-api {
	@doc "发送好友请求"
	@handler SendFriendRequest
	post /request (SendFriendRequestReq) returns (CommonResp)

	@doc "接受好友请求"
	@handler AcceptFriendRequest
	post /accept (HandleFriendRequestReq) returns (CommonResp)

	@doc "拒绝好友请求"
	@handler RejectFriendRequest
	post /reject (HandleFriendRequestReq) returns (CommonResp)

	@doc "获取好友列表"
	@handler GetFriendList
	get /list (GetFriendListReq) returns (GetFriendListResp)

	@doc "删除好友"
	@handler DeleteFriend
	post /delete (DeleteFriendReq) returns (CommonResp)

	@doc "加入黑名单"
	@handler BlacklistFriend
	post /blacklist (BlacklistFriendReq) returns (CommonResp)

	@doc "获取好友请求列表"
	@handler GetFriendRequests
	get /requests (GetFriendRequestsReq) returns (GetFriendRequestsResp)

	@doc "搜索用户"
	@handler SearchFriendUser
	get /search (SearchUserReq) returns (SearchUserResp)
}

// ==================== 关注模块 ====================
type FollowUserInfo {
	UserId      int64  `json:"user_id"`
	Nickname    string `json:"nickname"`
	Avatar      string `json:"avatar"`
	RankName    string `json:"rank_name"`
	IsFollowing bool   `json:"is_following"`
}

type FollowReq {
	TargetUserId int64 `json:"target_user_id"`
}

type GetFollowListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

type GetFollowListResp {
	Success bool             `json:"success"`
	Total   int64            `json:"total"`
	List    []FollowUserInfo `json:"list"`
}

@server (
	prefix: /api/follow
	group:  follow
	jwt:    Auth
)
service chasing_points-api {
	@doc "关注用户"
	@handler FollowUser
	post /follow (FollowReq) returns (CommonResp)

	@doc "取消关注"
	@handler UnfollowUser
	post /unfollow (FollowReq) returns (CommonResp)

	@doc "获取关注列表"
	@handler GetFollowingList
	get /following (GetFollowListReq) returns (GetFollowListResp)

	@doc "获取粉丝列表"
	@handler GetFollowerList
	get /followers (GetFollowListReq) returns (GetFollowListResp)
}

// ==================== 动态模块 ====================
type SocialPostInfo {
	Id            int64    `json:"id"`
	UserId        int64    `json:"user_id"`
	Nickname      string   `json:"nickname"`
	Avatar        string   `json:"avatar"`
	Content       string   `json:"content"`
	Images        []string `json:"images"`
	PostType      int      `json:"post_type"`
	MatchId       int64    `json:"match_id,omitempty"`
	LikesCount    int      `json:"likes_count"`
	CommentsCount int      `json:"comments_count"`
	IsLiked       bool     `json:"is_liked"`
	Status        int      `json:"status"`
	StatusText    string   `json:"status_text"`
	RejectReason  string   `json:"reject_reason,optional"`
	IsMine        bool     `json:"is_mine"`
	CreatedAt     string   `json:"created_at"`
}

type CreatePostReq {
	Content  string   `json:"content"`
	Images   []string `json:"images,optional"`
	PostType int      `json:"post_type"`
	MatchId  int64    `json:"match_id,optional"`
}

type CreatePostResp {
	Success bool  `json:"success"`
	PostId  int64 `json:"post_id"`
}

type GetPostListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

type GetPostListResp {
	Success bool             `json:"success"`
	Total   int64            `json:"total"`
	List    []SocialPostInfo `json:"list"`
}

type PostIdReq {
	PostId int64 `json:"post_id"`
}

type CommentPostReq {
	PostId  int64  `json:"post_id"`
	Content string `json:"content"`
}

type PostCommentInfo {
	Id        int64  `json:"id"`
	UserId    int64  `json:"user_id"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	Content   string `json:"content"`
	CreatedAt string `json:"created_at"`
}

type GetPostCommentsReq {
	PostId   int64 `form:"post_id"`
	Page     int   `form:"page,default=1"`
	PageSize int   `form:"page_size,default=20"`
}

type GetPostCommentsResp {
	Success bool              `json:"success"`
	Total   int64             `json:"total"`
	List    []PostCommentInfo `json:"list"`
}

@server (
	prefix: /api/social
	group:  social
)
service chasing_points-api {
	@doc "获取广场动态"
	@handler GetPublicPosts
	get /public (GetPostListReq) returns (GetPostListResp)
}

@server (
	prefix: /api/social
	group:  social
	jwt:    Auth
)
service chasing_points-api {
	@doc "发布动态"
	@handler CreatePost
	post /post (CreatePostReq) returns (CreatePostResp)

	@doc "获取关注的人的动态"
	@handler GetPostList
	get /feed (GetPostListReq) returns (GetPostListResp)

	@doc "获取我的动态"
	@handler GetMyPostList
	get /mine (GetPostListReq) returns (GetPostListResp)

	@doc "点赞动态"
	@handler LikePost
	post /like (PostIdReq) returns (CommonResp)

	@doc "取消点赞"
	@handler UnlikePost
	post /unlike (PostIdReq) returns (CommonResp)

	@doc "评论动态"
	@handler CommentPost
	post /comment (CommentPostReq) returns (CommonResp)

	@doc "删除动态"
	@handler DeletePost
	post /delete (PostIdReq) returns (CommonResp)

	@doc "获取动态评论"
	@handler GetPostComments
	get /comments (GetPostCommentsReq) returns (GetPostCommentsResp)
}

// ==================== 挑战模块 ====================
type ChallengeInfo {
	Id           int64  `json:"id"`
	MatchId      int64  `json:"match_id,optional"`
	FromUserId   int64  `json:"from_user_id"`
	FromNickname string `json:"from_nickname"`
	FromAvatar   string `json:"from_avatar"`
	ToUserId     int64  `json:"to_user_id"`
	ToNickname   string `json:"to_nickname"`
	ToAvatar     string `json:"to_avatar"`
	GameType     int    `json:"game_type"`
	Message      string `json:"message"`
	Status       int    `json:"status"`
	CreatedAt    string `json:"created_at"`
}

type SendChallengeReq {
	ToUserId int64  `json:"to_user_id"`
	GameType int    `json:"game_type"`
	Message  string `json:"message,optional"`
}

type SendChallengeResp {
	Success     bool  `json:"success"`
	ChallengeId int64 `json:"challenge_id"`
}

type HandleChallengeReq {
	ChallengeId int64 `json:"challenge_id"`
}

type GetPendingChallengesResp {
	Success bool            `json:"success"`
	List    []ChallengeInfo `json:"list"`
}

@server (
	prefix: /api/challenge
	group:  challenge
	jwt:    Auth
)
service chasing_points-api {
	@doc "发起挑战"
	@handler SendChallenge
	post /send (SendChallengeReq) returns (SendChallengeResp)

	@doc "接受挑战"
	@handler AcceptChallenge
	post /accept (HandleChallengeReq) returns (CommonResp)

	@doc "拒绝挑战"
	@handler RejectChallenge
	post /reject (HandleChallengeReq) returns (CommonResp)

	@doc "获取待处理挑战"
	@handler GetPendingChallenges
	get /pending returns (GetPendingChallengesResp)
}

// ==================== 赛事模块 ====================
type TournamentInfo {
	Id             int64  `json:"id"`
	CreatorId      int64  `json:"creator_id"`
	CreatorName    string `json:"creator_name"`
	Name           string `json:"name"`
	Description    string `json:"description"`
	CoverImage     string `json:"cover_image"`
	GameType       int    `json:"game_type"`
	Format         int    `json:"format"`
	MaxPlayers     int    `json:"max_players"`
	CurrentPlayers int    `json:"current_players"`
	Status         int    `json:"status"`
	Country        string `json:"country"`
	City           string `json:"city"`
	VenueName      string `json:"venue_name"`
	StartDate      string `json:"start_date"`
	EndDate        string `json:"end_date"`
	StartTime      string `json:"start_time,optional"`
	EndTime        string `json:"end_time,optional"`
	CreatedAt      string `json:"created_at"`
}

type GetTournamentListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Status   int    `form:"status,optional"`
	GameType int    `form:"game_type,optional"`
	City     string `form:"city,optional"`
}

type GetTournamentListResp {
	Success bool             `json:"success"`
	Total   int64            `json:"total"`
	List    []TournamentInfo `json:"list"`
}

type GetTournamentDetailReq {
	TournamentId int64 `form:"tournament_id"`
}

type TournamentParticipant {
	UserId    int64  `json:"user_id"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	Seed      int    `json:"seed"`
	Status    int    `json:"status"`
	FinalRank int    `json:"final_rank"`
}

type GetTournamentDetailResp {
	Success      bool                    `json:"success"`
	Tournament   *TournamentInfo         `json:"tournament"`
	Participants []TournamentParticipant `json:"participants"`
}

type TournamentBracketMatch {
	Id              int64  `json:"id"`
	RoundNumber     int    `json:"round_number"`
	MatchOrder      int    `json:"match_order"`
	Player1Id       int64  `json:"player1_id"`
	Player1Name     string `json:"player1_name"`
	Player2Id       int64  `json:"player2_id"`
	Player2Name     string `json:"player2_name"`
	WinnerId        int64  `json:"winner_id"`
	BracketPosition string `json:"bracket_position"`
	Status          int    `json:"status"`
}

type GetTournamentBracketReq {
	TournamentId int64 `form:"tournament_id"`
}

type GetTournamentBracketResp {
	Success     bool                     `json:"success"`
	Matches     []TournamentBracketMatch `json:"matches"`
	TotalRounds int                      `json:"total_rounds"`
}

// ==================== 赛事情报模块 ====================
type EventNewsInfo {
	Id               int64  `json:"id"`
	Title            string `json:"title"`
	SourceType       string `json:"source_type"`
	SourceName       string `json:"source_name"`
	SourceUrl        string `json:"source_url"`
	CoverImage       string `json:"cover_image"`
	Summary          string `json:"summary"`
	Content          string `json:"content"`
	Description      string `json:"description"`
	TournamentId     int64  `json:"tournament_id"`
	TournamentName   string `json:"tournament_name"`
	GameType         int    `json:"game_type"`
	Country          string `json:"country"`
	City             string `json:"city"`
	Venue            string `json:"venue"`
	StartDate        string `json:"start_date"`
	EndDate          string `json:"end_date"`
	StartTime        string `json:"start_time,optional"`
	EndTime          string `json:"end_time,optional"`
	Status           int    `json:"status"` // 0:即将开始 1:进行中 2:已结束 3:已取消
	CurrentRoundText string `json:"current_round_text"`
	LatestResultText string `json:"latest_result_text"`
	MatchCount       int    `json:"match_count"`
	SortTime         string `json:"sort_time"`
	Published        bool   `json:"published"`
	PublishedAt      string `json:"published_at"`
	CreatedAt        string `json:"created_at"`
	UpdatedAt        string `json:"updated_at"`
}

type EventNewsMatchInfo {
	Id                  int64  `json:"id"`
	EventId             int64  `json:"event_id"`
	TournamentId        int64  `json:"tournament_id"`
	SourceType          string `json:"source_type"`
	SourceMatchId       string `json:"source_match_id"`
	RoundName           string `json:"round_name"`
	RoundOrder          int    `json:"round_order"`
	MatchOrder          int    `json:"match_order"`
	StartTime           string `json:"start_time"`
	Status              int    `json:"status"`
	BestOf              int    `json:"best_of"`
	HomePlayerId        int64  `json:"home_player_id"`
	HomePlayerName      string `json:"home_player_name"`
	HomePlayerFirstName string `json:"home_player_first_name,optional"`
	HomePlayerLastName  string `json:"home_player_last_name,optional"`
	HomePlayerFlagEmoji string `json:"home_player_flag_emoji,optional"`
	HomePlayerAvatar    string `json:"home_player_avatar,optional"`
	AwayPlayerId        int64  `json:"away_player_id"`
	AwayPlayerName      string `json:"away_player_name"`
	AwayPlayerFirstName string `json:"away_player_first_name,optional"`
	AwayPlayerLastName  string `json:"away_player_last_name,optional"`
	AwayPlayerFlagEmoji string `json:"away_player_flag_emoji,optional"`
	AwayPlayerAvatar    string `json:"away_player_avatar,optional"`
	HomeScore           int    `json:"home_score"`
	AwayScore           int    `json:"away_score"`
	WinnerSide          int    `json:"winner_side"`
	IsPlaceholder       bool   `json:"is_placeholder"`
	CreatedAt           string `json:"created_at"`
	UpdatedAt           string `json:"updated_at"`
}

type GetEventNewsListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Status   int    `form:"status,optional,default=-1"`
	GameType int    `form:"game_type,optional"`
	City     string `form:"city,optional"`
	Year     int    `form:"year,optional"`
	From     string `form:"from,optional"`
	To       string `form:"to,optional"`
}

type GetEventNewsListResp {
	Success bool            `json:"success"`
	Total   int64           `json:"total"`
	List    []EventNewsInfo `json:"list"`
}

type GetEventNewsViewReq {
	EventId int64 `form:"event_id"`
}

type GetEventNewsViewResp {
	Success    bool                 `json:"success"`
	EventNews  *EventNewsInfo       `json:"event_news"`
	Tournament *TournamentInfo      `json:"tournament"`
	Matches    []EventNewsMatchInfo `json:"matches"`
}

