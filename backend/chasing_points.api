syntax = "v1"

// ==================== 通用类型 ====================
type UserInfo {
	Id        int64  `json:"id"`
	Phone     string `json:"phone"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	Status    int    `json:"status"`
	CreatedAt string `json:"created_at"`
}

// ==================== 认证相关 ====================
// 发送短信验证码
type SendSmsReq {
	Phone string `json:"phone"`
	Scene string `json:"scene,optional,default=login"` // login/bind
}

type SendSmsResp {
	Success bool   `json:"success"`
	Message string `json:"message"`
}

// 手机号登录
type LoginReq {
	Phone   string `json:"phone"`
	SmsCode string `json:"sms_code"`
}

type LoginResp {
	Success      bool      `json:"success"`
	AccessToken  string    `json:"access_token"`
	RefreshToken string    `json:"refresh_token"`
	ExpiresIn    int64     `json:"expires_in"`
	UserInfo     *UserInfo `json:"user_info"`
}

// OAuth登录
type LoginByOauthReq {
	Provider  string `json:"provider"` // huawei
	OpenId    string `json:"open_id"`
	UnionId   string `json:"union_id,optional"`
	NickName  string `json:"nick_name,optional"`
	AvatarUrl string `json:"avatar_url,optional"`
	Platform  string `json:"platform,optional"`
}

type LoginByOauthResp {
	Success       bool      `json:"success"`
	AccessToken   string    `json:"access_token"`
	RefreshToken  string    `json:"refresh_token"`
	ExpiresIn     int64     `json:"expires_in"`
	NeedBindPhone bool      `json:"need_bind_phone"`
	UserInfo      *UserInfo `json:"user_info"`
}

// 微信小程序一键登录
type WechatMiniLoginReq {
	Code string `json:"code"`
}

type WechatMiniLoginResp {
	Success       bool      `json:"success"`
	Message       string    `json:"message,optional"`
	AccessToken   string    `json:"access_token,optional"`
	RefreshToken  string    `json:"refresh_token,optional"`
	ExpiresIn     int64     `json:"expires_in,optional"`
	NeedBindPhone bool      `json:"need_bind_phone"`
	UserInfo      *UserInfo `json:"user_info,optional"`
}

// 刷新登录态
type RefreshTokenReq {
	RefreshToken string `json:"refresh_token"`
}

type RefreshTokenResp {
	Success      bool   `json:"success"`
	Message      string `json:"message,optional"`
	AccessToken  string `json:"access_token,optional"`
	RefreshToken string `json:"refresh_token,optional"`
	ExpiresIn    int64  `json:"expires_in,optional"`
}

// 绑定手机号
type BindPhoneReq {
	Phone   string `json:"phone"`
	SmsCode string `json:"sms_code"`
}

type BindPhoneResp {
	Success       bool      `json:"success"`
	Message       string    `json:"message"`
	MergedAccount bool      `json:"merged_account"`
	AccessToken   string    `json:"access_token,optional"`
	RefreshToken  string    `json:"refresh_token,optional"`
	ExpiresIn     int64     `json:"expires_in,optional"`
	NeedBindPhone bool      `json:"need_bind_phone"`
	UserInfo      *UserInfo `json:"user_info,optional"`
}

// 微信小程序绑定手机号
type WechatMiniBindPhoneReq {
	Code string `json:"code"`
}

type WechatMiniBindPhoneResp {
	Success       bool      `json:"success"`
	Message       string    `json:"message"`
	MergedAccount bool      `json:"merged_account"`
	AccessToken   string    `json:"access_token,optional"`
	RefreshToken  string    `json:"refresh_token,optional"`
	ExpiresIn     int64     `json:"expires_in,optional"`
	NeedBindPhone bool      `json:"need_bind_phone"`
	UserInfo      *UserInfo `json:"user_info,optional"`
}

// ==================== 服务定义 ====================
@server (
	prefix: /api/auth
	group:  auth
)
service chasing_points-api {
	@doc "发送短信验证码"
	@handler SendSms
	post /send-sms (SendSmsReq) returns (SendSmsResp)

	@doc "手机号登录/注册"
	@handler Login
	post /login (LoginReq) returns (LoginResp)

	@doc "OAuth登录"
	@handler LoginByOauth
	post /login-by-oauth (LoginByOauthReq) returns (LoginByOauthResp)

	@doc "微信小程序一键登录"
	@handler WechatMiniLogin
	post /wechat-mini-login (WechatMiniLoginReq) returns (WechatMiniLoginResp)

	@doc "刷新登录态"
	@handler RefreshToken
	post /refresh-token (RefreshTokenReq) returns (RefreshTokenResp)
}

// ==================== 公开接口 ====================
// 正在进行的对局列表项
type OngoingMatchItem {
	Id              int64  `json:"id"`
	GameType        int    `json:"game_type"`
	GameTypeName    string `json:"game_type_name"`
	MatchMode       string `json:"match_mode,optional"`
	Visibility      string `json:"visibility,optional"`
	FinishState     string `json:"finish_state,optional"`
	Player1Id       int64  `json:"player1_id"` // 玩家1(创建者)ID
	Player1Name     string `json:"player1_name"`
	Player1Avatar   string `json:"player1_avatar"`
	Player2Id       int64  `json:"player2_id"` // 玩家2(对手)ID，0表示非注册用户
	Player2Name     string `json:"player2_name"`
	Player2Avatar   string `json:"player2_avatar"`
	Player1Score    int    `json:"player1_score"`
	Player2Score    int    `json:"player2_score"`
	CurrentRound    int    `json:"current_round"`
	MatchTime       string `json:"match_time"` // 开始时间 ISO格式
	DurationSeconds int64  `json:"duration_seconds"` // 对局已持续秒数，由服务端计算
}

// 获取正在进行的对局列表请求
type GetOngoingMatchesReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

// 获取正在进行的对局列表响应
type GetOngoingMatchesResp {
	Success bool               `json:"success"`
	Total   int64              `json:"total"`
	List    []OngoingMatchItem `json:"list"`
}

type PublicMatchListReq {
	Scope    string `form:"scope,optional"` // hall/friends
	Status   int    `form:"status,optional,default=1"` // 1=进行中 2=已完成，仅大厅模式使用
	GameType int    `form:"game_type,optional"` // 0=全部 1=斯诺克 2=九球追分 3=中式八球 4=美式九球
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
}

type PublicMatchListItem {
	Id              int64  `json:"id"`
	GameType        int    `json:"game_type"`
	GameTypeName    string `json:"game_type_name"`
	MatchMode       string `json:"match_mode,optional"`
	Visibility      string `json:"visibility,optional"`
	FinishState     string `json:"finish_state,optional"`
	Status          int    `json:"status"`
	StatusText      string `json:"status_text"`
	Player1Id       int64  `json:"player1_id"`
	Player1Name     string `json:"player1_name"`
	Player1Avatar   string `json:"player1_avatar"`
	Player2Id       int64  `json:"player2_id"`
	Player2Name     string `json:"player2_name"`
	Player2Avatar   string `json:"player2_avatar"`
	Player1Score    int    `json:"player1_score"`
	Player2Score    int    `json:"player2_score"`
	CurrentRound    int    `json:"current_round"`
	Result          int    `json:"result,optional"`
	MatchTime       string `json:"match_time"`
	EndTime         string `json:"end_time,optional"`
	DurationSeconds int64  `json:"duration_seconds"`
}

type PublicMatchListResp {
	Success bool                  `json:"success"`
	Message string                `json:"message,optional"`
	Total   int64                 `json:"total"`
	List    []PublicMatchListItem `json:"list"`
}

// 公开对局详情请求（观战模式）
type GetPublicMatchDetailReq {
	MatchId int64 `form:"match_id"`
}

// 局记录
type RoundRecord {
	RoundNumber  int `json:"round_number"`
	Player1Score int `json:"player1_score"`
	Player2Score int `json:"player2_score"`
	Winner       int `json:"winner"` // 1=玩家1胜 2=玩家2胜
}

// 公开对局详情数据（第三方视角）
type PublicMatchDetailData {
	Id                            int64         `json:"id"`
	GameType                      int           `json:"game_type"`
	MatchMode                     string        `json:"match_mode,optional"`
	Visibility                    string        `json:"visibility,optional"`
	FinishState                   string        `json:"finish_state,optional"`
	Status                        int           `json:"status"` // 1=进行中 2=已完成 3=已取消
	ServerRevision                int64         `json:"server_revision"`
	Player1Id                     int64         `json:"player1_id"`
	Player1Name                   string        `json:"player1_name"`
	Player1Avatar                 string        `json:"player1_avatar"`
	Player2Id                     int64         `json:"player2_id"`
	Player2Name                   string        `json:"player2_name"`
	Player2Avatar                 string        `json:"player2_avatar"`
	RefereeBound                  bool          `json:"referee_bound,optional"`
	RefereeUserId                 int64         `json:"referee_user_id,optional"`
	RefereeName                   string        `json:"referee_name,optional"`
	RefereeAvatar                 string        `json:"referee_avatar,optional"`
	RefereeJoinedAt               string        `json:"referee_joined_at,optional"`
	CompletedByUserId             int64         `json:"completed_by_user_id,optional"`
	CompletionSource              string        `json:"completion_source,optional"`
	ViewerRole                    string        `json:"viewer_role,optional"`
	Player1Score                  int           `json:"player1_score"`
	Player2Score                  int           `json:"player2_score"`
	CurrentFramePlayer1Score      int           `json:"current_frame_player1_score,optional"`
	CurrentFramePlayer2Score      int           `json:"current_frame_player2_score,optional"`
	CurrentFrameStarted           bool          `json:"current_frame_started,optional"`
	SnookerRulesVersion           int           `json:"snooker_rules_version,optional"`
	BestOfFrames                  int           `json:"best_of_frames,optional"`
	StartingActor                 int           `json:"starting_actor,optional"`
	SnookerPhase                  string        `json:"snooker_phase,optional"`
	SnookerBallOn                 string        `json:"snooker_ball_on,optional"`
	SnookerStriker                int           `json:"snooker_striker,optional"`
	SnookerVisitNo                int           `json:"snooker_visit_no,optional"`
	SnookerCurrentBreak           int           `json:"snooker_current_break,optional"`
	SnookerRedsRemaining          int           `json:"snooker_reds_remaining,optional"`
	SnookerFreeBallAvailable      bool          `json:"snooker_free_ball_available,optional"`
	SnookerCueBallInHand          bool          `json:"snooker_cue_ball_in_hand,optional"`
	SnookerMissWarningActive      bool          `json:"snooker_miss_warning_active,optional"`
	SnookerRespottedBlackPending  bool          `json:"snooker_respotted_black_pending,optional"`
	SnookerPendingConcessionActor int           `json:"snooker_pending_concession_actor,optional"`
	SnookerPendingConcessionScope string        `json:"snooker_pending_concession_scope,optional"`
	SnookerFrameEndReason         string        `json:"snooker_frame_end_reason,optional"`
	CurrentRound                  int           `json:"current_round"`
	TotalRounds                   int           `json:"total_rounds"`
	DurationSeconds               int64         `json:"duration_seconds"`
	RefereeDurationSeconds        int64         `json:"referee_duration_seconds,optional"`
	Rounds                        []RoundRecord `json:"rounds"` // 局记录
	CreatedAt                     string        `json:"created_at"`
}

// 公开对局详情响应
type GetPublicMatchDetailResp {
	Success bool                   `json:"success"`
	Match   *PublicMatchDetailData `json:"match"`
}

@server (
	prefix: /api/public
	group:  public
)
service chasing_points-api {
	@doc (
		summary:     "获取正在进行的对局列表"
		description: "获取平台所有正在进行的对局列表，公开接口无需登录"
	)
	@handler GetOngoingMatches
	get /matches/ongoing (GetOngoingMatchesReq) returns (GetOngoingMatchesResp)

	@doc (
		summary:     "获取公开观赛对局列表"
		description: "获取大厅或好友维度的观赛对局列表；大厅公开可看，好友列表需登录"
	)
	@handler GetPublicMatches
	get /matches (PublicMatchListReq) returns (PublicMatchListResp)

	@doc (
		summary:     "获取段位排行榜"
		description: "获取按排位分排序的用户排行榜，包含前三名和分页列表，公开接口无需登录"
	)
	@handler GetLeaderboard
	get /rank/leaderboard (GetLeaderboardReq) returns (GetLeaderboardResp)

	@doc (
		summary:     "获取公开对局详情"
		description: "获取对局详情（观战模式），公开接口无需登录，使用第三方视角"
	)
	@handler GetPublicMatchDetail
	get /match/detail (GetPublicMatchDetailReq) returns (GetPublicMatchDetailResp)
}

@server (
	prefix: /api/auth
	group:  auth
	jwt:    Auth
)
service chasing_points-api {
	@doc "绑定手机号"
	@handler BindPhone
	post /bind-phone (BindPhoneReq) returns (BindPhoneResp)

	@doc "微信小程序绑定手机号"
	@handler WechatMiniBindPhone
	post /wechat-mini-bind-phone (WechatMiniBindPhoneReq) returns (WechatMiniBindPhoneResp)
}

// ==================== 用户相关 ====================
// 更新昵称
type UpdateNicknameReq {
	Nickname string `json:"nickname"`
}

type UpdateNicknameResp {
	Success  bool      `json:"success"`
	Message  string    `json:"message"`
	UserInfo *UserInfo `json:"user_info"`
}

// 获取用户信息
type GetUserInfoResp {
	Success  bool      `json:"success"`
	UserInfo *UserInfo `json:"user_info"`
}

type GetUserReputationResp {
	Success    bool   `json:"success"`
	Score      int    `json:"score"`
	Status     string `json:"status"`
	StatusText string `json:"status_text"`
	BanUntil   string `json:"ban_until,optional"`
}

type UserReputationLogItem {
	Id             int64  `json:"id"`
	MatchId        int64  `json:"match_id,optional"`
	ChangeType     string `json:"change_type"`
	ChangeTypeText string `json:"change_type_text"`
	ReasonCode     string `json:"reason_code"`
	ReasonText     string `json:"reason_text"`
	ChangeScore    int    `json:"change_score"`
	BeforeScore    int    `json:"before_score"`
	AfterScore     int    `json:"after_score"`
	CreatedAt      string `json:"created_at"`
}

type UserReputationLogsReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

type UserReputationLogsResp {
	Success bool                    `json:"success"`
	Total   int64                   `json:"total"`
	List    []UserReputationLogItem `json:"list"`
}

type GetQiniuUploadTokenReq {
	FileExt string `form:"file_ext,optional"`
}

type GetQiniuUploadTokenResp {
	Success     bool   `json:"success"`
	Message     string `json:"message"`
	UploadToken string `json:"upload_token,optional"`
	Key         string `json:"key,optional"`
	UploadUrl   string `json:"upload_url,optional"`
	Domain      string `json:"domain,optional"`
}

type UpdateUserProfileReq {
	Nickname string `json:"nickname,optional"`
	Avatar   string `json:"avatar,optional"`
}

type UpdateUserProfileResp {
	Success  bool      `json:"success"`
	Message  string    `json:"message"`
	UserInfo *UserInfo `json:"user_info"`
}

type GetUserPrivacyResp {
	Success         bool `json:"success"`
	HideMatchRecord bool `json:"hide_match_record"`
}

type UpdateUserPrivacyReq {
	HideMatchRecord bool `json:"hide_match_record"`
}

type UpdateUserPrivacyResp {
	Success         bool   `json:"success"`
	Message         string `json:"message"`
	HideMatchRecord bool   `json:"hide_match_record"`
}

type FavoriteVenueRewardStatusResp {
	Success            bool   `json:"success"`
	Enabled            bool   `json:"enabled"`
	PopupEnabled       bool   `json:"popup_enabled"`
	RewardDays         int    `json:"reward_days"`
	NewUserWindowDays  int    `json:"new_user_window_days"`
	Status             string `json:"status"`
	MemberExpiresAt    string `json:"member_expires_at,optional"`
	SubmittedVenueId   int64  `json:"submitted_venue_id,optional"`
	SubmittedVenueName string `json:"submitted_venue_name,optional"`
	RejectReason       string `json:"reject_reason,optional"`
}

// 更新推送令牌
type UpdatePushTokenReq {
	PushClientId string `json:"push_client_id"`
}

// 用户统计数据
type UserStatsResp {
	Success      bool    `json:"success"`
	TotalMatches int     `json:"total_matches"` // 总对局数
	Wins         int     `json:"wins"` // 胜场数
	Losses       int     `json:"losses"` // 负场数
	WinRate      float64 `json:"win_rate"` // 胜率(百分比)
	MaxWinStreak int     `json:"max_win_streak"` // 最高连胜
}

@server (
	prefix: /api/user
	group:  user
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取当前用户信息"
	@handler GetUserInfo
	get /info returns (GetUserInfoResp)

	@doc "获取当前用户信誉状态"
	@handler GetUserReputation
	get /reputation returns (GetUserReputationResp)

	@doc "获取当前用户信誉流水"
	@handler GetUserReputationLogs
	get /reputation/logs (UserReputationLogsReq) returns (UserReputationLogsResp)

	@doc "获取七牛上传凭证"
	@handler GetQiniuUploadToken
	get /upload-token (GetQiniuUploadTokenReq) returns (GetQiniuUploadTokenResp)

	@doc "获取用户隐私设置"
	@handler GetUserPrivacy
	get /privacy returns (GetUserPrivacyResp)

	@doc "更新用户隐私设置"
	@handler UpdateUserPrivacy
	post /privacy (UpdateUserPrivacyReq) returns (UpdateUserPrivacyResp)

	@doc "获取常玩球馆奖励状态"
	@handler GetFavoriteVenueRewardStatus
	get /favorite-venue-reward-status returns (FavoriteVenueRewardStatusResp)

	@doc "获取用户统计数据"
	@handler GetUserStats
	get /stats returns (UserStatsResp)

	@doc "更新昵称"
	@handler UpdateNickname
	post /nickname (UpdateNicknameReq) returns (UpdateNicknameResp)

	@doc "更新用户资料"
	@handler UpdateUserProfile
	post /profile (UpdateUserProfileReq) returns (UpdateUserProfileResp)

	@doc "更新推送令牌"
	@handler UpdatePushToken
	post /push-token (UpdatePushTokenReq) returns (CommonResp)

	@doc "提交投诉举报与意见反馈"
	@handler CreateUserFeedbackTicket
	post /feedback/create (CreateFeedbackTicketReq) returns (CreateFeedbackTicketResp)
}

// ==================== 对局相关 ====================
// 通用响应
type CommonResp {
	Success bool   `json:"success"`
	Message string `json:"message"`
}

// ==================== 投诉举报与意见反馈 ====================
type CreateFeedbackTicketReq {
	Source   string `json:"source,optional,default=app"` // app/website
	Category string `json:"category,optional,default=feedback"` // feedback/complaint/report
	Content  string `json:"content"`
	Contact  string `json:"contact,optional"`
}

type CreateFeedbackTicketResp {
	Success  bool   `json:"success"`
	Message  string `json:"message"`
	TicketId int64  `json:"ticket_id"`
}

@server (
	prefix: /api/feedback
	group:  feedback
)
service chasing_points-api {
	@doc "公开提交投诉举报与意见反馈"
	@handler CreateFeedbackTicket
	post /create (CreateFeedbackTicketReq) returns (CreateFeedbackTicketResp)
}

// ==================== 会员订阅 ====================
type MemberPlanInfo {
	PlanCode      string `json:"plan_code"`
	PlanName      string `json:"plan_name"`
	PriceFen      int    `json:"price_fen"`
	PriceYuan     string `json:"price_yuan"`
	DurationDays  int    `json:"duration_days"`
	DurationLabel string `json:"duration_label"`
	Description   string `json:"description"`
	Highlight     string `json:"highlight,optional"`
}

type GetMemberPlansResp {
	Success     bool             `json:"success"`
	CurrentTime string           `json:"current_time"`
	Plans       []MemberPlanInfo `json:"plans"`
}

type GetMemberStatusResp {
	Success               bool   `json:"success"`
	IsActive              bool   `json:"is_active"`
	CurrentTime           string `json:"current_time"`
	PlanCode              string `json:"plan_code,optional"`
	PlanName              string `json:"plan_name,optional"`
	MemberExpiresAt       string `json:"member_expires_at,optional"`
	GrowthLevel           int    `json:"growth_level,optional"`
	GrowthPoints          int    `json:"growth_points,optional"`
	TodayGrowthCount      int    `json:"today_growth_count,optional"`
	GrowthDailyCap        int    `json:"growth_daily_cap,optional"`
	GrowthFrozen          bool   `json:"growth_frozen,optional"`
	NextGrowthLevel       int    `json:"next_growth_level,optional"`
	NextGrowthLevelPoints int    `json:"next_growth_level_points,optional"`
	RemainingGrowthPoints int    `json:"remaining_growth_points,optional"`
}

type CreateMemberSubscriptionOrderReq {
	PlanCode   string `json:"plan_code"`
	PayChannel string `json:"pay_channel"`
}

type WechatAppPayParams {
	Appid     string `json:"appid"`
	Partnerid string `json:"partnerid"`
	Prepayid  string `json:"prepayid"`
	Package   string `json:"package"`
	Noncestr  string `json:"noncestr"`
	Timestamp string `json:"timestamp"`
	Sign      string `json:"sign"`
}

type CreateMemberSubscriptionOrderResp {
	Success            bool                `json:"success"`
	Message            string              `json:"message"`
	OrderNo            string              `json:"order_no"`
	PayChannel         string              `json:"pay_channel"`
	PlanCode           string              `json:"plan_code"`
	PlanName           string              `json:"plan_name"`
	AmountFen          int                 `json:"amount_fen"`
	AmountYuan         string              `json:"amount_yuan"`
	Status             string              `json:"status"`
	AlipayOrderString  string              `json:"alipay_order_string,optional"`
	WechatAppPayParams *WechatAppPayParams `json:"wechat_app_pay_params,optional"`
}

type GetMemberSubscriptionOrderStatusReq {
	OrderNo string `form:"order_no"`
}

type GetMemberSubscriptionOrderStatusResp {
	Success               bool   `json:"success"`
	Message               string `json:"message,optional"`
	OrderNo               string `json:"order_no"`
	PayChannel            string `json:"pay_channel"`
	PlanCode              string `json:"plan_code"`
	PlanName              string `json:"plan_name"`
	AmountFen             int    `json:"amount_fen"`
	AmountYuan            string `json:"amount_yuan"`
	Status                string `json:"status"`
	PaidAt                string `json:"paid_at,optional"`
	MemberExpiresAtBefore string `json:"member_expires_at_before,optional"`
	MemberExpiresAtAfter  string `json:"member_expires_at_after,optional"`
}

@server (
	prefix: /api/member
	group:  member
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取会员套餐列表"
	@handler GetMemberPlans
	get /plans returns (GetMemberPlansResp)

	@doc "获取会员状态"
	@handler GetMemberStatus
	get /status returns (GetMemberStatusResp)

	@doc "创建会员订阅订单"
	@handler CreateMemberSubscriptionOrder
	post /order (CreateMemberSubscriptionOrderReq) returns (CreateMemberSubscriptionOrderResp)

	@doc "查询会员订阅订单状态"
	@handler GetMemberSubscriptionOrderStatus
	get /order/status (GetMemberSubscriptionOrderStatusReq) returns (GetMemberSubscriptionOrderStatusResp)
}

@server (
	prefix: /api/payment
	group:  payment
)
service chasing_points-api {
	@doc "支付宝会员支付异步回调"
	@handler AlipayMemberSubscriptionNotify
	post /alipay/notify returns (CommonResp)

	@doc "微信会员支付异步回调"
	@handler WechatMemberSubscriptionNotify
	post /wechat/notify returns (CommonResp)
}

// 特殊成绩项
type AchievementItem {
	Type  string `json:"type"`
	Count int    `json:"count"`
}

// 对局同步快照（当前登录用户视角）
type MatchLastAction {
	ActionType     string `json:"action_type,optional"`
	Actor          int    `json:"actor,optional"`
	ScoreChange    int    `json:"score_change,optional"`
	ServerRevision int64  `json:"server_revision,optional"`
	Description    string `json:"description,optional"`
}

type MatchSyncSnapshot {
	MatchId                       int64            `json:"match_id"`
	Status                        int              `json:"status"`
	ServerRevision                int64            `json:"server_revision"`
	MatchMode                     string           `json:"match_mode,optional"`
	Visibility                    string           `json:"visibility,optional"`
	FinishState                   string           `json:"finish_state,optional"`
	FinishRequestedBy             int64            `json:"finish_requested_by,optional"`
	ViewerRole                    string           `json:"viewer_role,optional"`
	RefereeBound                  bool             `json:"referee_bound,optional"`
	RefereeUserId                 int64            `json:"referee_user_id,optional"`
	RefereeName                   string           `json:"referee_name,optional"`
	RefereeAvatar                 string           `json:"referee_avatar,optional"`
	RefereeJoinedAt               string           `json:"referee_joined_at,optional"`
	CompletedByUserId             int64            `json:"completed_by_user_id,optional"`
	CompletionSource              string           `json:"completion_source,optional"`
	RefereeDurationSeconds        int64            `json:"referee_duration_seconds,optional"`
	CanScore                      bool             `json:"can_score,optional"`
	CanUndo                       bool             `json:"can_undo,optional"`
	CanFinish                     bool             `json:"can_finish,optional"`
	CanRequestFinish              bool             `json:"can_request_finish,optional"`
	CanConfirmFinish              bool             `json:"can_confirm_finish,optional"`
	CanDisputeFinish              bool             `json:"can_dispute_finish,optional"`
	CanWithdrawFinish             bool             `json:"can_withdraw_finish,optional"`
	LastAction                    *MatchLastAction `json:"last_action,optional"`
	MyScore                       int              `json:"my_score"`
	OpponentScore                 int              `json:"opponent_score"`
	CurrentFrameStarted           bool             `json:"current_frame_started,optional"`
	CurrentFrameMyScore           int              `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore     int              `json:"current_frame_opponent_score,optional"`
	CurrentRound                  int              `json:"current_round"`
	TotalRounds                   int              `json:"total_rounds"`
	RedBallCount                  int              `json:"red_ball_count,optional"`
	SnookerClearanceStarted       bool             `json:"snooker_clearance_started,optional"`
	SnookerClearedColors          []int            `json:"snooker_cleared_colors,optional"`
	SnookerExpectedClearanceScore int              `json:"snooker_expected_clearance_score,optional"`
	SnookerClearanceCompleted     bool             `json:"snooker_clearance_completed,optional"`
	SnookerRulesVersion           int              `json:"snooker_rules_version,optional"`
	BestOfFrames                  int              `json:"best_of_frames,optional"`
	StartingActor                 int              `json:"starting_actor,optional"`
	SnookerPhase                  string           `json:"snooker_phase,optional"`
	SnookerBallOn                 string           `json:"snooker_ball_on,optional"`
	SnookerStriker                int              `json:"snooker_striker,optional"`
	SnookerVisitNo                int              `json:"snooker_visit_no,optional"`
	SnookerCurrentBreak           int              `json:"snooker_current_break,optional"`
	SnookerRedsRemaining          int              `json:"snooker_reds_remaining,optional"`
	SnookerFreeBallAvailable      bool             `json:"snooker_free_ball_available,optional"`
	SnookerCueBallInHand          bool             `json:"snooker_cue_ball_in_hand,optional"`
	SnookerMissWarningActive      bool             `json:"snooker_miss_warning_active,optional"`
	SnookerRespottedBlackPending  bool             `json:"snooker_respotted_black_pending,optional"`
	SnookerPendingConcessionActor int              `json:"snooker_pending_concession_actor,optional"`
	SnookerPendingConcessionScope string           `json:"snooker_pending_concession_scope,optional"`
	SnookerFrameEndReason         string           `json:"snooker_frame_end_reason,optional"`
}

// 开始对局
type StartMatchReq {
	GameType            int    `json:"game_type"` // 1=斯诺克 2=九球追分 3=中式八球 4=美式九球
	GameMode            string `json:"game_mode,optional"` // 比赛模式
	MatchMode           string `json:"match_mode,optional"` // practice/ranked，缺省按 ranked
	Visibility          string `json:"visibility,optional"` // private/public，排位固定 public
	OpponentId          int64  `json:"opponent_id"` // 对手ID（平台用户，必填）
	OpponentName        string `json:"opponent_name"` // 对手昵称
	OpponentAvatar      string `json:"opponent_avatar,optional"` // 对手头像
	ChallengeId         int64  `json:"challenge_id,optional"` // 已接受邀约 ID
	SnookerRulesVersion int    `json:"snooker_rules_version,optional"` // 斯诺克规则版本：旧客户端缺省为1，新客户端显式提交2
	BestOfFrames        int    `json:"best_of_frames,optional"` // 版本2斯诺克总局数，必须为正奇数
	StartingActor       int    `json:"starting_actor,optional"` // 版本2斯诺克首局开球方：1/2
}

type StartMatchResp {
	Success      bool              `json:"success"`
	Action       string            `json:"action,optional"` // created/resume_existing/blocked
	BlockReason  string            `json:"block_reason,optional"` // self_ongoing/opponent_ongoing
	Message      string            `json:"message,optional"`
	MatchId      int64             `json:"match_id"`
	Match        *CurrentMatchInfo `json:"match,optional"`
	OngoingMatch *CurrentMatchInfo `json:"ongoing_match,optional"`
}

// 加分
type MatchScoreReq {
	MatchId        int64  `json:"match_id"`
	Actor          int    `json:"actor"` // 1=选手1 2=选手2
	Score          int    `json:"score"` // 加的分数
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type MatchScoreResp {
	Accepted                      bool              `json:"accepted"`
	Success                       bool              `json:"success"`
	Message                       string            `json:"message,optional"`
	ClientActionId                string            `json:"client_action_id,optional"`
	ServerRevision                int64             `json:"server_revision"`
	Snapshot                      MatchSyncSnapshot `json:"snapshot"`
	RedBallCount                  int               `json:"red_ball_count,optional"`
	SnookerClearanceStarted       bool              `json:"snooker_clearance_started,optional"`
	SnookerClearedColors          []int             `json:"snooker_cleared_colors,optional"`
	SnookerExpectedClearanceScore int               `json:"snooker_expected_clearance_score,optional"`
	SnookerClearanceCompleted     bool              `json:"snooker_clearance_completed,optional"`
	CurrentFrameStarted           bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore           int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore     int               `json:"current_frame_opponent_score,optional"`
	MyScore                       int               `json:"my_score"`
	OpponentScore                 int               `json:"opponent_score"`
}

// 结束一局
type EndRoundReq {
	MatchId        int64  `json:"match_id"`
	Winner         int    `json:"winner"` // 1=选手1 2=选手2
	WinType        string `json:"win_type,optional"` // 获胜方式
	Score          int    `json:"score,optional,default=1"` // 获胜得分，默认1分
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type EndRoundResp {
	Accepted                  bool              `json:"accepted"`
	Success                   bool              `json:"success"`
	ClientActionId            string            `json:"client_action_id,optional"`
	ServerRevision            int64             `json:"server_revision"`
	Snapshot                  MatchSyncSnapshot `json:"snapshot"`
	RoundNo                   int               `json:"round_no"`
	CurrentFrameStarted       bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore       int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore int               `json:"current_frame_opponent_score,optional"`
	MyScore                   int               `json:"my_score"`
	OpponentScore             int               `json:"opponent_score"`
}

// 开始下一局
type StartNextRoundReq {
	MatchId        int64  `json:"match_id"`
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type StartNextRoundResp {
	Accepted                  bool              `json:"accepted"`
	Success                   bool              `json:"success"`
	ClientActionId            string            `json:"client_action_id,optional"`
	ServerRevision            int64             `json:"server_revision"`
	Snapshot                  MatchSyncSnapshot `json:"snapshot"`
	RoundNo                   int               `json:"round_no"` // 新局数
	CurrentFrameStarted       bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore       int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore int               `json:"current_frame_opponent_score,optional"`
	MyScore                   int               `json:"my_score"` // 我方总分
	OpponentScore             int               `json:"opponent_score"` // 对手总分
}

// 犯规
type MatchFoulReq {
	MatchId        int64  `json:"match_id"`
	Actor          int    `json:"actor"` // 犯规方：1=选手1 2=选手2
	Score          int    `json:"score,optional"` // 斯诺克旧规则兼容；版本2只允许专用动作接口
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

// 斯诺克一次击球结果
// outcome: pot/no_score/foul
// foul_resolution: incoming_plays/offender_plays_from_left/offender_replays_original
type SnookerStrokeReq {
	MatchId              int64  `json:"match_id"`
	Actor                int    `json:"actor"`
	Outcome              string `json:"outcome"`
	BallOnValue          int    `json:"ball_on_value,optional"`
	PottedReds           int    `json:"potted_reds,optional"`
	BallOnPotted         bool   `json:"ball_on_potted,optional"`
	FreeBallValue        int    `json:"free_ball_value,optional"`
	FreeBallPotted       bool   `json:"free_ball_potted,optional"`
	Penalty              int    `json:"penalty,optional"`
	RedsRemoved          int    `json:"reds_removed,optional"`
	FoulAndMiss          bool   `json:"foul_and_miss,optional"`
	MissSequenceEligible bool   `json:"miss_sequence_eligible,optional"`
	FoulResolution       string `json:"foul_resolution,optional"`
	FreeBallAwarded      bool   `json:"free_ball_awarded,optional"`
	CueBallInHand        bool   `json:"cue_ball_in_hand,optional"`
	ClientActionId       string `json:"client_action_id"`
	BaseRevision         int64  `json:"base_revision"`
}

// 斯诺克局级动作
// action: start_respotted_black/offer_concession/accept_concession/reject_concession/award_frame
type SnookerFrameActionReq {
	MatchId        int64  `json:"match_id"`
	Actor          int    `json:"actor"`
	Action         string `json:"action"`
	Scope          string `json:"scope,optional"`
	Winner         int    `json:"winner,optional"`
	Reason         string `json:"reason,optional"`
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type SnookerActionResp {
	Accepted       bool              `json:"accepted"`
	Success        bool              `json:"success"`
	Message        string            `json:"message,optional"`
	ClientActionId string            `json:"client_action_id,optional"`
	ServerRevision int64             `json:"server_revision"`
	Snapshot       MatchSyncSnapshot `json:"snapshot"`
}

// 撤销
