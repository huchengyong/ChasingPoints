type AdminMemberGrowthRules {
	PointsPerCompletedMatch int    `json:"points_per_completed_match"`
	DailyCap                int    `json:"daily_cap"`
	LevelThresholdLv2       int    `json:"level_threshold_lv2"`
	LevelThresholdLv3       int    `json:"level_threshold_lv3"`
	LevelThresholdLv4       int    `json:"level_threshold_lv4"`
	LevelThresholdLv5       int    `json:"level_threshold_lv5"`
	ExpireStrategy          string `json:"expire_strategy"`
}

type AdminMemberRankingRightsRules {
	OrdinaryUserAchievementEnabled bool `json:"ordinary_user_achievement_enabled"`
	DailyCap                       int  `json:"daily_cap"`
	DailyPositiveCap               int  `json:"daily_positive_cap"`
	Break50Score                   int  `json:"break_50_score"`
	GoldenBreakScore               int  `json:"golden_break_score"`
	BreakAndRunScore               int  `json:"break_and_run_score"`
	RunOutScore                    int  `json:"run_out_score"`
	Break100Score                  int  `json:"break_100_score"`
	NineOnBreakScore               int  `json:"nine_on_break_score"`
	Break147Score                  int  `json:"break_147_score"`
	Level1Multiplier               int  `json:"level1_multiplier"`
	Level2Multiplier               int  `json:"level2_multiplier"`
	Level3Multiplier               int  `json:"level3_multiplier"`
	Level4Multiplier               int  `json:"level4_multiplier"`
	Level5Multiplier               int  `json:"level5_multiplier"`
}

type AdminMemberRightsConfigResp {
	Code          int                           `json:"code"`
	Success       bool                          `json:"success"`
	Message       string                        `json:"message"`
	GrowthRules   AdminMemberGrowthRules        `json:"growth_rules"`
	RankingRights AdminMemberRankingRightsRules `json:"ranking_rights_rules"`
}

type AdminMemberRightsConfigUpdateReq {
	GrowthRules   AdminMemberGrowthRules        `json:"growth_rules"`
	RankingRights AdminMemberRankingRightsRules `json:"ranking_rights_rules"`
}

type AdminReputationBaseRules {
	MaxScore         int `json:"max_score"`
	InitialScore     int `json:"initial_score"`
	BanThreshold     int `json:"ban_threshold"`
	BanDurationHours int `json:"ban_duration_hours"`
	MinScore         int `json:"min_score"`
}

type AdminReputationRecoveryRules {
	Enabled         bool `json:"enabled"`
	RecoverPerHour  int  `json:"recover_per_hour"`
	RecoverMaxScore int  `json:"recover_max_score"`
}

type AdminReputationDurationRule {
	GameType                int  `json:"game_type"`
	Enabled                 bool `json:"enabled"`
	MinMinutesPerRound      int  `json:"min_minutes_per_round"`
	MinTotalRounds          int  `json:"min_total_rounds"`
	MinTotalDurationMinutes int  `json:"min_total_duration_minutes"`
	PenaltyScore            int  `json:"penalty_score"`
}

type AdminReputationSameOpponentRule {
	Enabled             bool `json:"enabled"`
	WindowMinutes       int  `json:"window_minutes"`
	MaxMatches          int  `json:"max_matches"`
	PenaltyScore        int  `json:"penalty_score"`
	RequireSameGameType bool `json:"require_same_game_type"`
}

type AdminReputationDetectionRules {
	DurationRules          []AdminReputationDurationRule   `json:"duration_rules"`
	SameOpponentRule       AdminReputationSameOpponentRule `json:"same_opponent_rule"`
	StackPenaltiesPerMatch bool                            `json:"stack_penalties_per_match"`
}

type AdminReputationConfigResp {
	Code           int                           `json:"code"`
	Success        bool                          `json:"success"`
	Message        string                        `json:"message"`
	BaseRules      AdminReputationBaseRules      `json:"base_rules"`
	RecoveryRules  AdminReputationRecoveryRules  `json:"recovery_rules"`
	DetectionRules AdminReputationDetectionRules `json:"detection_rules"`
}

type AdminReputationConfigUpdateReq {
	BaseRules      AdminReputationBaseRules      `json:"base_rules"`
	RecoveryRules  AdminReputationRecoveryRules  `json:"recovery_rules"`
	DetectionRules AdminReputationDetectionRules `json:"detection_rules"`
}

type AdminReputationLogListReq {
	Page       int    `form:"page,default=1"`
	PageSize   int    `form:"page_size,default=20"`
	UserId     int64  `form:"user_id,optional"`
	ChangeType string `form:"change_type,optional"`
	ReasonCode string `form:"reason_code,optional"`
}

type AdminReputationLogItem {
	Id              int64  `json:"id"`
	UserId          int64  `json:"user_id"`
	Nickname        string `json:"nickname"`
	MatchId         int64  `json:"match_id,optional"`
	ChangeType      string `json:"change_type"`
	ChangeTypeText  string `json:"change_type_text"`
	ReasonCode      string `json:"reason_code"`
	ReasonText      string `json:"reason_text"`
	ReasonDetail    string `json:"reason_detail,optional"`
	ChangeScore     int    `json:"change_score"`
	BeforeScore     int    `json:"before_score"`
	AfterScore      int    `json:"after_score"`
	OperatorAdminId int64  `json:"operator_admin_id,optional"`
	OperatorText    string `json:"operator_text"`
	CreatedAt       string `json:"created_at"`
}

type AdminReputationLogListResp {
	Code    int                      `json:"code"`
	Success bool                     `json:"success"`
	Message string                   `json:"message"`
	Total   int64                    `json:"total"`
	List    []AdminReputationLogItem `json:"list"`
}

// ==================== Admin 动态审核 ====================
type AdminSocialPostListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
	Status   int `form:"status,default=-1"` // -1:全部 1:已发布 2:待审核 3:已拒绝
}

type AdminSocialPostInfo {
	Id            int64    `json:"id"`
	UserId        int64    `json:"user_id"`
	Nickname      string   `json:"nickname"`
	Avatar        string   `json:"avatar"`
	Content       string   `json:"content"`
	Images        []string `json:"images"`
	PostType      int      `json:"post_type"`
	MatchId       int64    `json:"match_id,omitempty"`
	LikesCount    int      `json:"likes_count"`
	CommentsCount int      `json:"comments_count"`
	Status        int      `json:"status"`
	StatusText    string   `json:"status_text"`
	RejectReason  string   `json:"reject_reason"`
	ReviewedAt    string   `json:"reviewed_at,optional"`
	ReviewedBy    int64    `json:"reviewed_by,optional"`
	CreatedAt     string   `json:"created_at"`
}

type AdminSocialPostListResp {
	Code    int                   `json:"code"`
	Success bool                  `json:"success"`
	Message string                `json:"message"`
	Total   int64                 `json:"total"`
	List    []AdminSocialPostInfo `json:"list"`
}

type AdminSocialPostReviewReq {
	PostId       int64  `json:"post_id"`
	Status       int    `json:"status"` // 1:通过 3:拒绝
	RejectReason string `json:"reject_reason,optional"`
}

// ==================== Admin 投诉举报工单 ====================
type AdminFeedbackTicketListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Status   int    `form:"status,optional,default=-1"` // -1:全部 1:待处理 2:处理中 3:已办结 4:已关闭
	Category string `form:"category,optional"`
	Source   string `form:"source,optional"`
}

type AdminFeedbackTicketInfo {
	Id            int64  `json:"id"`
	UserId        int64  `json:"user_id,optional"`
	Source        string `json:"source"`
	SourceText    string `json:"source_text"`
	Category      string `json:"category"`
	CategoryText  string `json:"category_text"`
	Content       string `json:"content"`
	Contact       string `json:"contact"`
	Status        int    `json:"status"`
	StatusText    string `json:"status_text"`
	HandlerId     int64  `json:"handler_id,optional"`
	ProcessResult string `json:"process_result,optional"`
	ProcessedAt   string `json:"processed_at,optional"`
	CreatedAt     string `json:"created_at"`
	UpdatedAt     string `json:"updated_at"`
}

type AdminFeedbackTicketListResp {
	Code    int                       `json:"code"`
	Success bool                      `json:"success"`
	Message string                    `json:"message"`
	Total   int64                     `json:"total"`
	List    []AdminFeedbackTicketInfo `json:"list"`
}

type AdminFeedbackTicketProcessReq {
	TicketId      int64  `json:"ticket_id"`
	Status        int    `json:"status"` // 2:处理中 3:已办结 4:已关闭
	ProcessResult string `json:"process_result,optional"`
}

@server (
	prefix: /api/admin/venue
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取球馆列表（管理员）"
	@handler AdminGetVenueList
	get /list (AdminVenueListReq) returns (AdminVenueListResp)

	@doc "获取常玩球馆奖励配置"
	@handler AdminGetVenueRewardConfig
	get /reward-config returns (AdminVenueRewardConfigResp)

	@doc "更新常玩球馆奖励配置"
	@handler AdminUpdateVenueRewardConfig
	post /reward-config (AdminVenueRewardConfigUpdateReq) returns (AdminWriteResp)

	@doc "获取常玩球馆奖励发放记录"
	@handler AdminGetVenueRewardRecordList
	get /reward-records (AdminVenueRewardRecordListReq) returns (AdminVenueRewardRecordListResp)

	@doc "审核球馆"
	@handler AdminReviewVenue
	post /review (AdminVenueReviewReq) returns (AdminVenueReviewResp)
}

@server (
	prefix: /api/admin/member
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取会员成长与排位权益配置"
	@handler AdminGetMemberRightsConfig
	get /ranking-rights-config returns (AdminMemberRightsConfigResp)

	@doc "更新会员成长与排位权益配置"
	@handler AdminUpdateMemberRightsConfig
	post /ranking-rights-config (AdminMemberRightsConfigUpdateReq) returns (AdminWriteResp)
}

@server (
	prefix: /api/admin/reputation
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取信誉制度配置"
	@handler AdminGetReputationConfig
	get /config returns (AdminReputationConfigResp)

	@doc "更新信誉制度配置"
	@handler AdminUpdateReputationConfig
	post /config (AdminReputationConfigUpdateReq) returns (AdminWriteResp)

	@doc "获取信誉变更日志列表"
	@handler AdminGetReputationLogList
	get /logs (AdminReputationLogListReq) returns (AdminReputationLogListResp)
}

@server (
	prefix: /api/admin/social
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取动态列表（管理员）"
	@handler AdminGetSocialPostList
	get /posts (AdminSocialPostListReq) returns (AdminSocialPostListResp)

	@doc "审核动态"
	@handler AdminReviewSocialPost
	post /review (AdminSocialPostReviewReq) returns (AdminWriteResp)
}

@server (
	prefix: /api/admin/feedback
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取投诉举报与反馈工单列表"
	@handler AdminGetFeedbackTicketList
	get /list (AdminFeedbackTicketListReq) returns (AdminFeedbackTicketListResp)

	@doc "处理投诉举报与反馈工单"
	@handler AdminProcessFeedbackTicket
	post /process (AdminFeedbackTicketProcessReq) returns (AdminWriteResp)
}

// ==================== Admin 用户管理 ====================
type AdminUserListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
	Status   int `form:"status,optional,default=-1"`
}

type AdminUserInfo {
	Id              int64  `json:"id"`
	Phone           string `json:"phone"`
	Nickname        string `json:"nickname"`
	Avatar          string `json:"avatar"`
	Status          int    `json:"status"`
	ReputationScore int    `json:"reputation_score"`
	BanUntil        string `json:"ban_until,optional"`
	MemberStatus    string `json:"member_status"`
	MemberExpiresAt string `json:"member_expires_at,optional"`
	CreatedAt       string `json:"created_at"`
}

type AdminUserListResp {
	Code    int             `json:"code"`
	Success bool            `json:"success"`
	Message string          `json:"message"`
	Total   int64           `json:"total"`
	List    []AdminUserInfo `json:"list"`
}

type AdminUserUpdateStatusReq {
	UserId int64 `json:"user_id"`
	Status int   `json:"status"`
}

@server (
	prefix: /api/admin/users
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取用户列表（管理员）"
	@handler AdminGetUserList
	get /list (AdminUserListReq) returns (AdminUserListResp)

	@doc "更新用户状态"
	@handler AdminUpdateUserStatus
	post /update-status (AdminUserUpdateStatusReq) returns (AdminWriteResp)
}

// ==================== Admin 首页统计 ====================
type AdminDashboardStatsResp {
	Code           int    `json:"code"`
	Success        bool   `json:"success"`
	Message        string `json:"message"`
	TotalUsers     int64  `json:"total_users"`
	TodayNewUsers  int64  `json:"today_new_users"`
	TotalMatches   int64  `json:"total_matches"`
	OngoingMatches int64  `json:"ongoing_matches"`
}

type AdminRecentUser {
	Id        int64  `json:"id"`
	Nickname  string `json:"nickname"`
	Phone     string `json:"phone"`
	CreatedAt string `json:"created_at"`
}

type AdminRecentUsersResp {
	Code    int               `json:"code"`
	Success bool              `json:"success"`
	Message string            `json:"message"`
	List    []AdminRecentUser `json:"list"`
}

type AdminRecentMatch {
	Id            int64  `json:"id"`
	GameType      int    `json:"game_type"`
	GameTypeName  string `json:"game_type_name"`
	MatchMode     string `json:"match_mode,optional"`
	Visibility    string `json:"visibility,optional"`
	FinishState   string `json:"finish_state,optional"`
	Player1Name   string `json:"player1_name"`
	Player2Name   string `json:"player2_name"`
	MyScore       int    `json:"my_score"`
	OpponentScore int    `json:"opponent_score"`
	Status        int    `json:"status"`
	CreatedAt     string `json:"created_at"`
}

type AdminRecentMatchesResp {
	Code    int                `json:"code"`
	Success bool               `json:"success"`
	Message string             `json:"message"`
	List    []AdminRecentMatch `json:"list"`
}

@server (
	prefix: /api/admin/dashboard
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取首页统计数据"
	@handler AdminGetDashboardStats
	get /stats returns (AdminDashboardStatsResp)

	@doc "获取最近注册用户"
	@handler AdminGetRecentUsers
	get /recent-users returns (AdminRecentUsersResp)

	@doc "获取最近对局"
	@handler AdminGetRecentMatches
	get /recent-matches returns (AdminRecentMatchesResp)
}

// ==================== Admin 对局管理 ====================
type AdminMatchListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
	Status   int `form:"status,optional,default=-1"` // -1:全部 1:进行中 2:已完成 3:已取消
	GameType int `form:"game_type,optional,default=-1"` // -1:全部 1:斯诺克 2:九球追分 3:中式八球 4:美式九球
}

type AdminMatchInfo {
	Id            int64  `json:"id"`
	GameType      int    `json:"game_type"`
	GameTypeName  string `json:"game_type_name"`
	MatchMode     string `json:"match_mode,optional"`
	Visibility    string `json:"visibility,optional"`
	FinishState   string `json:"finish_state,optional"`
	Player1Name   string `json:"player1_name"`
	Player2Name   string `json:"player2_name"`
	MyScore       int    `json:"my_score"`
	OpponentScore int    `json:"opponent_score"`
	Status        int    `json:"status"`
	StatusText    string `json:"status_text"`
	Result        *int   `json:"result,omitempty"`
	WinnerName    string `json:"winner_name"`
	MatchTime     string `json:"match_time"`
	CreatedAt     string `json:"created_at"`
}

type AdminMatchListResp {
	Code    int              `json:"code"`
	Success bool             `json:"success"`
	Message string           `json:"message"`
	Total   int64            `json:"total"`
	List    []AdminMatchInfo `json:"list"`
}

@server (
	prefix: /api/admin/match
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取对局列表（管理员）"
	@handler AdminGetMatchList
	get /list (AdminMatchListReq) returns (AdminMatchListResp)
}

