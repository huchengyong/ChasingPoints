	prefix: /api/tournament
	group:  tournament
	jwt:    Auth
)
service chasing_points-api {
	@doc "创建赛事"
	@handler CreateTournament
	post /create (CreateTournamentReq) returns (CreateTournamentResp)

	@doc "报名赛事"
	@handler JoinTournament
	post /join (TournamentIdReq) returns (CommonResp)

	@doc "退出赛事"
	@handler LeaveTournament
	post /leave (TournamentIdReq) returns (CommonResp)

	@doc "签到赛事"
	@handler CheckinTournament
	post /checkin (TournamentIdReq) returns (CommonResp)

	@doc "更新赛事对局结果"
	@handler UpdateTournamentMatch
	post /match/update (UpdateTournamentMatchReq) returns (CommonResp)

	@doc "结束赛事"
	@handler FinishTournament
	post /finish (TournamentIdReq) returns (CommonResp)

	@doc "取消赛事"
	@handler CancelTournament
	post /cancel (TournamentIdReq) returns (CommonResp)

	@doc "获取我的赛事"
	@handler GetMyTournaments
	get /my (GetMyTournamentsReq) returns (GetTournamentListResp)
}

// ==================== 赛事情报管理 ====================
type AdminEventNewsListReq {
	Page      int `form:"page,default=1"`
	PageSize  int `form:"page_size,default=20"`
	Status    int `form:"status,optional,default=-1"`
	GameType  int `form:"game_type,optional,default=-1"`
	Published int `form:"published,optional,default=-1"` // -1:全部 0:未发布 1:已发布
}

type AdminEventNewsListResp {
	Code    int             `json:"code"`
	Success bool            `json:"success"`
	Message string          `json:"message"`
	Total   int64           `json:"total"`
	List    []EventNewsInfo `json:"list"`
}

type AdminEventNewsCreateReq {
	Title      string `json:"title"`
	GameType   int    `json:"game_type"`
	SourceType string `json:"source_type,optional"`
	SourceName string `json:"source_name,optional"`
	SourceUrl  string `json:"source_url,optional"`
	CoverImage string `json:"cover_image,optional"`
	Summary    string `json:"summary,optional"`
	Content    string `json:"content,optional"`
	Country    string `json:"country,optional"`
	City       string `json:"city,optional"`
	Venue      string `json:"venue,optional"`
	StartTime  string `json:"start_time"`
	EndTime    string `json:"end_time,optional"`
	Status     int    `json:"status"`
	Featured   bool   `json:"featured,optional"`
	SortTime   string `json:"sort_time,optional"`
}

type AdminEventNewsUpdateReq {
	EventId    int64  `json:"event_id"`
	Title      string `json:"title"`
	GameType   int    `json:"game_type"`
	SourceType string `json:"source_type,optional"`
	SourceName string `json:"source_name,optional"`
	SourceUrl  string `json:"source_url,optional"`
	CoverImage string `json:"cover_image,optional"`
	Summary    string `json:"summary,optional"`
	Content    string `json:"content,optional"`
	Country    string `json:"country,optional"`
	City       string `json:"city,optional"`
	Venue      string `json:"venue,optional"`
	StartTime  string `json:"start_time"`
	EndTime    string `json:"end_time,optional"`
	Status     int    `json:"status"`
	Featured   bool   `json:"featured,optional"`
	SortTime   string `json:"sort_time,optional"`
}

type AdminEventNewsIdReq {
	EventId int64 `json:"event_id"`
}

type AdminEventNewsPublishReq {
	EventId   int64 `json:"event_id"`
	Published bool  `json:"published"`
}

type AdminEventNewsStageCreateReq {
	EventId    int64  `json:"event_id"`
	StageName  string `json:"stage_name"`
	StageOrder int    `json:"stage_order"`
	StartTime  string `json:"start_time,optional"`
	EndTime    string `json:"end_time,optional"`
	Status     int    `json:"status"`
	ResultText string `json:"result_text,optional"`
	SortTime   string `json:"sort_time,optional"`
}

type AdminEventNewsStageUpdateReq {
	StageId    int64  `json:"stage_id"`
	EventId    int64  `json:"event_id"`
	StageName  string `json:"stage_name"`
	StageOrder int    `json:"stage_order"`
	StartTime  string `json:"start_time,optional"`
	EndTime    string `json:"end_time,optional"`
	Status     int    `json:"status"`
	ResultText string `json:"result_text,optional"`
	SortTime   string `json:"sort_time,optional"`
}

type AdminEventNewsStageIdReq {
	StageId int64 `json:"stage_id"`
}

@server (
	prefix: /api/admin/event-news
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取赛事情报列表（管理员）"
	@handler AdminGetEventNewsList
	get /list (AdminEventNewsListReq) returns (AdminEventNewsListResp)

	@doc "创建赛事情报"
	@handler AdminCreateEventNews
	post /create (AdminEventNewsCreateReq) returns (AdminWriteResp)

	@doc "更新赛事情报"
	@handler AdminUpdateEventNews
	post /update (AdminEventNewsUpdateReq) returns (AdminWriteResp)

	@doc "发布或下线赛事情报"
	@handler AdminPublishEventNews
	post /publish (AdminEventNewsPublishReq) returns (AdminWriteResp)

	@doc "删除赛事情报"
	@handler AdminDeleteEventNews
	post /delete (AdminEventNewsIdReq) returns (AdminWriteResp)

	@doc "创建赛事阶段"
	@handler AdminCreateEventNewsStage
	post /stage/create (AdminEventNewsStageCreateReq) returns (AdminWriteResp)

	@doc "更新赛事阶段"
	@handler AdminUpdateEventNewsStage
	post /stage/update (AdminEventNewsStageUpdateReq) returns (AdminWriteResp)

	@doc "删除赛事阶段"
	@handler AdminDeleteEventNewsStage
	post /stage/delete (AdminEventNewsStageIdReq) returns (AdminWriteResp)
}

// ==================== 赛季模块 ====================
type SeasonInfo {
	Id             int64   `json:"id"`
