}

// ==================== 分享模块 ====================
type GetMatchShareDataReq {
	MatchId int64 `form:"match_id"`
}

type MatchShareData {
	MatchId           int64              `json:"match_id"`
	GameType          int                `json:"game_type"`
	GameTypeName      string             `json:"game_type_name"`
	MyName            string             `json:"my_name"`
	MyAvatar          string             `json:"my_avatar"`
	MyScore           int                `json:"my_score"`
	OpponentName      string             `json:"opponent_name"`
	OpponentAvatar    string             `json:"opponent_avatar"`
	OpponentScore     int                `json:"opponent_score"`
	Result            string             `json:"result"`
	MatchTime         string             `json:"match_time"`
	RankChange        int                `json:"rank_change"`
	SummaryHighlights []MatchSummaryItem `json:"summary_highlights,optional"`
	SummaryStats      []MatchSummaryItem `json:"summary_stats,optional"`
}

type GetMatchShareDataResp {
	Success bool            `json:"success"`
	Data    *MatchShareData `json:"data"`
}

type GetTournamentShareDataReq {
	TournamentId int64 `form:"tournament_id"`
}

type TournamentShareData {
	TournamentId   int64  `json:"tournament_id"`
	TournamentName string `json:"tournament_name"`
	FinalRank      int    `json:"final_rank"`
	TotalPlayers   int    `json:"total_players"`
	MatchesPlayed  int    `json:"matches_played"`
	MatchesWon     int    `json:"matches_won"`
}

type GetTournamentShareDataResp {
	Success bool                 `json:"success"`
	Data    *TournamentShareData `json:"data"`
}

@server (
	prefix: /api/share
	group:  share
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取对局分享数据"
	@handler GetMatchShareData
	get /match (GetMatchShareDataReq) returns (GetMatchShareDataResp)

	@doc "获取赛事分享数据"
	@handler GetTournamentShareData
	get /tournament (GetTournamentShareDataReq) returns (GetTournamentShareDataResp)
}

// ==================== 深度统计模块 ====================
type GameTypeStats {
	GameType     int     `json:"game_type"`
	GameTypeName string  `json:"game_type_name"`
	TotalMatches int     `json:"total_matches"`
	Wins         int     `json:"wins"`
	Losses       int     `json:"losses"`
	WinRate      float64 `json:"win_rate"`
	HighestScore int     `json:"highest_score"`
}

type TrendPoint {
	MatchId   int64   `json:"match_id"`
	Date      string  `json:"date"`
	WinRate   float64 `json:"win_rate"`
	RankScore int     `json:"rank_score,omitempty"`
	Result    int     `json:"result"`
}

type SingleHighScoreRecord {
	MatchId      int64  `json:"match_id"`
	Score        int    `json:"score"`
	GameType     int    `json:"game_type"`
	GameTypeName string `json:"game_type_name"`
	OpponentName string `json:"opponent_name"`
	Date         string `json:"date"`
}

type DurationStats {
	AverageSeconds int `json:"average_seconds"`
	FastestSeconds int `json:"fastest_seconds"`
	LongestSeconds int `json:"longest_seconds"`
	TotalMatches   int `json:"total_matches"`
}

type OpponentStrengthItem {
	RankRange string  `json:"rank_range"`
	Matches   int     `json:"matches"`
	Wins      int     `json:"wins"`
	WinRate   float64 `json:"win_rate"`
}

type GetStatsByGameTypeResp {
	Success bool            `json:"success"`
	List    []GameTypeStats `json:"list"`
}

type GetRecentTrendReq {
	Limit    int `form:"limit,optional,default=30"`
	GameType int `form:"game_type,optional"`
}

type GetRecentTrendResp {
	Success bool         `json:"success"`
	List    []TrendPoint `json:"list"`
}

type GetRankScoreTrendReq {
	Limit    int `form:"limit,optional,default=30"`
	GameType int `form:"game_type,optional,default=3"`
}

type GetRankScoreTrendResp {
	Success bool         `json:"success"`
	List    []TrendPoint `json:"list"`
}

type GetSingleHighScoreReq {
	GameType int `form:"game_type,optional"`
	Limit    int `form:"limit,optional,default=10"`
}

type GetSingleHighScoreResp {
	Success bool                    `json:"success"`
	List    []SingleHighScoreRecord `json:"list"`
}

type GetMatchDurationStatsReq {
	GameType int `form:"game_type,optional"`
}

type GetMatchDurationStatsResp {
	Success bool           `json:"success"`
	Stats   *DurationStats `json:"stats"`
}

type GetOpponentStrengthResp {
	Success bool                   `json:"success"`
	List    []OpponentStrengthItem `json:"list"`
}

@server (
	prefix: /api/stats
	group:  stats
	jwt:    Auth
)
service chasing_points-api {
	@doc "分球种统计"
	@handler GetStatsByGameType
	get /by-game-type returns (GetStatsByGameTypeResp)

	@doc "近N场胜率趋势"
	@handler GetRecentTrend
	get /recent-trend (GetRecentTrendReq) returns (GetRecentTrendResp)

	@doc "段位分变化趋势"
	@handler GetRankScoreTrend
	get /rank-score-trend (GetRankScoreTrendReq) returns (GetRankScoreTrendResp)

	@doc "单杆最高分记录"
	@handler GetSingleHighScore
	get /single-high-score (GetSingleHighScoreReq) returns (GetSingleHighScoreResp)

	@doc "对局时长统计"
	@handler GetMatchDurationStats
	get /match-duration (GetMatchDurationStatsReq) returns (GetMatchDurationStatsResp)

	@doc "强弱对手分析"
	@handler GetOpponentStrength
	get /opponent-strength returns (GetOpponentStrengthResp)
}

// ==================== Admin 管理后台 ====================
type AdminLoginReq {
	Email    string `json:"email"`
	Password string `json:"password"`
}

type AdminLoginResp {
	Code     int        `json:"code"`
	Success  bool       `json:"success"`
	Message  string     `json:"message"`
	Token    string     `json:"token"`
	UserInfo *AdminInfo `json:"userInfo"`
}

type AdminInfo {
	Id       int64  `json:"id"`
	Email    string `json:"email"`
	Nickname string `json:"nickname"`
	Avatar   string `json:"avatar"`
	Role     string `json:"role"`
}

type AdminInitReq {
	Email      string `json:"email"`
	Password   string `json:"password"`
	SetupToken string `json:"setup_token"`
}

type AdminInitResp {
	Code    int    `json:"code"`
	Success bool   `json:"success"`
	Message string `json:"message"`
}

type AdminChangePasswordReq {
	OldPassword string `json:"old_password"`
	NewPassword string `json:"new_password"`
}

type AdminWriteResp {
	Code    int    `json:"code"`
	Success bool   `json:"success"`
	Message string `json:"message"`
}

type AdminUserInfoResp {
	Code     int        `json:"code"`
	Success  bool       `json:"success"`
	Message  string     `json:"message"`
	UserInfo *AdminInfo `json:"userInfo"`
}

type AdminExistsResp {
	Code    int    `json:"code"`
	Success bool   `json:"success"`
	Message string `json:"message"`
	Exists  bool   `json:"exists"`
}

@server (
	prefix: /api/admin
	group:  admin
)
service chasing_points-api {
	@doc "管理员登录"
	@handler AdminLogin
	post /login (AdminLoginReq) returns (AdminLoginResp)

	@doc "初始化管理员账号"
	@handler AdminInit
	post /init (AdminInitReq) returns (AdminInitResp)

	@doc "检查管理员账号是否存在"
	@handler AdminExists
	get /exists returns (AdminExistsResp)
}

@server (
	prefix: /api/admin/user
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取当前管理员信息"
	@handler AdminUserInfo
	get /info returns (AdminUserInfoResp)

	@doc "修改管理员密码"
	@handler AdminChangePassword
	post /change-password (AdminChangePasswordReq) returns (AdminWriteResp)
}

// ==================== Admin 球馆审核 ====================
type AdminVenueListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Status   int    `form:"status,default=-1"` // -1:全部 0:隐藏 1:已发布 2:待审核 3:已拒绝
	City     string `form:"city,optional"`
}

type AdminVenueInfo {
	Id            int64   `json:"id"`
	Name          string  `json:"name"`
	Address       string  `json:"address"`
	City          string  `json:"city"`
	District      string  `json:"district"`
	Latitude      float64 `json:"latitude"`
	Longitude     float64 `json:"longitude"`
	Phone         string  `json:"phone"`
	Images        string  `json:"images"`
	BusinessHours string  `json:"business_hours"`
	TableCount    int     `json:"table_count"`
	PriceRange    string  `json:"price_range"`
	Description   string  `json:"description"`
	Status        int     `json:"status"`
	GeoStatus     int     `json:"geo_status"`
	OwnerUserId   int64   `json:"owner_user_id"`
	RejectReason  string  `json:"reject_reason"`
	CreatedAt     string  `json:"created_at"`
}

type AdminVenueListResp {
	Code    int              `json:"code"`
	Success bool             `json:"success"`
	Message string           `json:"message"`
	Total   int64            `json:"total"`
	List    []AdminVenueInfo `json:"list"`
}

type AdminVenueReviewReq {
	VenueId      int64  `json:"venue_id"`
	Status       int    `json:"status"` // 1:通过 3:拒绝
	RejectReason string `json:"reject_reason,optional"`
}

type AdminVenueReviewResp {
	Code    int    `json:"code"`
	Success bool   `json:"success"`
	Message string `json:"message"`
}

type AdminVenueRewardConfigResp {
	Code              int    `json:"code"`
	Success           bool   `json:"success"`
	Message           string `json:"message"`
	Enabled           bool   `json:"enabled"`
	PopupEnabled      bool   `json:"popup_enabled"`
	RewardDays        int    `json:"reward_days"`
	NewUserWindowDays int    `json:"new_user_window_days"`
	StartAt           string `json:"start_at,optional"`
	EndAt             string `json:"end_at,optional"`
}

type AdminVenueRewardConfigUpdateReq {
	Enabled           bool   `json:"enabled"`
	PopupEnabled      bool   `json:"popup_enabled"`
	RewardDays        int    `json:"reward_days"`
	NewUserWindowDays int    `json:"new_user_window_days"`
	StartAt           string `json:"start_at,optional"`
	EndAt             string `json:"end_at,optional"`
}

type AdminVenueRewardRecordListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

type AdminVenueRewardRecordInfo {
	Id                    int64  `json:"id"`
	UserId                int64  `json:"user_id"`
	UserNickname          string `json:"user_nickname"`
	UserPhone             string `json:"user_phone"`
	VenueId               int64  `json:"venue_id"`
	VenueName             string `json:"venue_name"`
	RewardDays            int    `json:"reward_days"`
	MemberExpiresAtBefore string `json:"member_expires_at_before,optional"`
	MemberExpiresAtAfter  string `json:"member_expires_at_after"`
	GrantedAt             string `json:"granted_at"`
}

type AdminVenueRewardRecordListResp {
	Code    int                          `json:"code"`
	Success bool                         `json:"success"`
	Message string                       `json:"message"`
	Total   int64                        `json:"total"`
	List    []AdminVenueRewardRecordInfo `json:"list"`
}

@server (
	prefix: /api/admin/venue
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取球馆列表（管理员）"
	@handler AdminGetVenueList
	get /list (AdminVenueListReq) returns (AdminVenueListResp)

	@doc "获取常玩球馆奖励配置"
	@handler AdminGetVenueRewardConfig
	get /reward-config returns (AdminVenueRewardConfigResp)

	@doc "更新常玩球馆奖励配置"
	@handler AdminUpdateVenueRewardConfig
	post /reward-config (AdminVenueRewardConfigUpdateReq) returns (AdminWriteResp)

	@doc "获取常玩球馆奖励发放记录"
	@handler AdminGetVenueRewardRecordList
	get /reward-records (AdminVenueRewardRecordListReq) returns (AdminVenueRewardRecordListResp)

	@doc "审核球馆"
	@handler AdminReviewVenue
	post /review (AdminVenueReviewReq) returns (AdminVenueReviewResp)
}

// ==================== Admin 用户管理 ====================
type AdminUserListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
	Status   int `form:"status,optional,default=-1"`
}

type AdminUserInfo {
	Id        int64  `json:"id"`
	Phone     string `json:"phone"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	Status    int    `json:"status"`
	CreatedAt string `json:"created_at"`
}

type AdminUserListResp {
	Code    int             `json:"code"`
	Success bool            `json:"success"`
	Message string          `json:"message"`
	Total   int64           `json:"total"`
	List    []AdminUserInfo `json:"list"`
}

type AdminUserUpdateStatusReq {
	UserId int64 `json:"user_id"`
	Status int   `json:"status"`
}

@server (
	prefix: /api/admin/users
	group:  admin
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取用户列表（管理员）"
	@handler AdminGetUserList
	get /list (AdminUserListReq) returns (AdminUserListResp)

	@doc "更新用户状态"
	@handler AdminUpdateUserStatus
	post /update-status (AdminUserUpdateStatusReq) returns (AdminWriteResp)
}

// ==================== Admin 首页统计 ====================
type AdminDashboardStatsResp {
	Code           int    `json:"code"`
	Success        bool   `json:"success"`
	Message        string `json:"message"`
	TotalUsers     int64  `json:"total_users"`
	TodayNewUsers  int64  `json:"today_new_users"`
	TotalMatches   int64  `json:"total_matches"`
	OngoingMatches int64  `json:"ongoing_matches"`
}

type AdminRecentUser {
	Id        int64  `json:"id"`
	Nickname  string `json:"nickname"`
	Phone     string `json:"phone"`
	CreatedAt string `json:"created_at"`
}

type AdminRecentUsersResp {
	Code    int               `json:"code"`
	Success bool              `json:"success"`
	Message string            `json:"message"`
	List    []AdminRecentUser `json:"list"`
}

type AdminRecentMatch {
	Id            int64  `json:"id"`
	GameType      int    `json:"game_type"`
	GameTypeName  string `json:"game_type_name"`
	Player1Name   string `json:"player1_name"`
	Player2Name   string `json:"player2_name"`
