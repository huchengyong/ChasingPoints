syntax = "v1"

// ==================== 通用类型 ====================
type UserInfo {
	Id        int64  `json:"id"`
	Phone     string `json:"phone"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	Status    int    `json:"status"`
	CreatedAt string `json:"created_at"`
}

// ==================== 认证相关 ====================
// 发送短信验证码
type SendSmsReq {
	Phone string `json:"phone"`
	Scene string `json:"scene,optional,default=login"` // login/bind
}

type SendSmsResp {
	Success bool   `json:"success"`
	Message string `json:"message"`
}

// 手机号登录
type LoginReq {
	Phone   string `json:"phone"`
	SmsCode string `json:"sms_code"`
}

type LoginResp {
	Success      bool      `json:"success"`
	AccessToken  string    `json:"access_token"`
	RefreshToken string    `json:"refresh_token"`
	ExpiresIn    int64     `json:"expires_in"`
	UserInfo     *UserInfo `json:"user_info"`
}

// OAuth登录
type LoginByOauthReq {
	Provider  string `json:"provider"` // huawei
	OpenId    string `json:"open_id"`
	UnionId   string `json:"union_id,optional"`
	NickName  string `json:"nick_name,optional"`
	AvatarUrl string `json:"avatar_url,optional"`
	Platform  string `json:"platform,optional"`
}

type LoginByOauthResp {
	Success       bool      `json:"success"`
	AccessToken   string    `json:"access_token"`
	RefreshToken  string    `json:"refresh_token"`
	ExpiresIn     int64     `json:"expires_in"`
	NeedBindPhone bool      `json:"need_bind_phone"`
	UserInfo      *UserInfo `json:"user_info"`
}

// 绑定手机号
type BindPhoneReq {
	Phone   string `json:"phone"`
	SmsCode string `json:"sms_code"`
}

type BindPhoneResp {
	Success       bool   `json:"success"`
	Message       string `json:"message"`
	MergedAccount bool   `json:"merged_account"`
}

// ==================== 服务定义 ====================
@server (
	prefix: /api/auth
	group:  auth
)
service chasing_points-api {
	@doc "发送短信验证码"
	@handler SendSms
	post /send-sms (SendSmsReq) returns (SendSmsResp)

	@doc "手机号登录/注册"
	@handler Login
	post /login (LoginReq) returns (LoginResp)

	@doc "OAuth登录"
	@handler LoginByOauth
	post /login-by-oauth (LoginByOauthReq) returns (LoginByOauthResp)
}

// ==================== 公开接口 ====================
// 正在进行的对局列表项
type OngoingMatchItem {
	Id              int64  `json:"id"`
	GameType        int    `json:"game_type"`
	GameTypeName    string `json:"game_type_name"`
	Player1Id       int64  `json:"player1_id"` // 玩家1(创建者)ID
	Player1Name     string `json:"player1_name"`
	Player1Avatar   string `json:"player1_avatar"`
	Player2Id       int64  `json:"player2_id"` // 玩家2(对手)ID，0表示非注册用户
	Player2Name     string `json:"player2_name"`
	Player2Avatar   string `json:"player2_avatar"`
	Player1Score    int    `json:"player1_score"`
	Player2Score    int    `json:"player2_score"`
	CurrentRound    int    `json:"current_round"`
	MatchTime       string `json:"match_time"` // 开始时间 ISO格式
	DurationSeconds int64  `json:"duration_seconds"` // 对局已持续秒数，由服务端计算
}

// 获取正在进行的对局列表请求
type GetOngoingMatchesReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

// 获取正在进行的对局列表响应
type GetOngoingMatchesResp {
	Success bool               `json:"success"`
	Total   int64              `json:"total"`
	List    []OngoingMatchItem `json:"list"`
}

// 公开对局详情请求（观战模式）
type GetPublicMatchDetailReq {
	MatchId int64 `form:"match_id"`
}

// 局记录
type RoundRecord {
	RoundNumber  int `json:"round_number"`
	Player1Score int `json:"player1_score"`
	Player2Score int `json:"player2_score"`
	Winner       int `json:"winner"` // 1=玩家1胜 2=玩家2胜
}

// 公开对局详情数据（第三方视角）
type PublicMatchDetailData {
	Id                       int64         `json:"id"`
	GameType                 int           `json:"game_type"`
	Status                   int           `json:"status"` // 1=进行中 2=已完成 3=已取消
	ServerRevision           int64         `json:"server_revision"`
	Player1Id                int64         `json:"player1_id"`
	Player1Name              string        `json:"player1_name"`
	Player1Avatar            string        `json:"player1_avatar"`
	Player2Id                int64         `json:"player2_id"`
	Player2Name              string        `json:"player2_name"`
	Player2Avatar            string        `json:"player2_avatar"`
	Player1Score             int           `json:"player1_score"`
	Player2Score             int           `json:"player2_score"`
	CurrentFramePlayer1Score int           `json:"current_frame_player1_score,optional"`
	CurrentFramePlayer2Score int           `json:"current_frame_player2_score,optional"`
	CurrentFrameStarted      bool          `json:"current_frame_started,optional"`
	CurrentRound             int           `json:"current_round"`
	TotalRounds              int           `json:"total_rounds"`
	DurationSeconds          int64         `json:"duration_seconds"`
	Rounds                   []RoundRecord `json:"rounds"` // 局记录
	CreatedAt                string        `json:"created_at"`
}

// 公开对局详情响应
type GetPublicMatchDetailResp {
	Success bool                   `json:"success"`
	Match   *PublicMatchDetailData `json:"match"`
}

@server (
	prefix: /api/public
	group:  public
)
service chasing_points-api {
	@doc (
		summary:     "获取正在进行的对局列表"
		description: "获取平台所有正在进行的对局列表，公开接口无需登录"
	)
	@handler GetOngoingMatches
	get /matches/ongoing (GetOngoingMatchesReq) returns (GetOngoingMatchesResp)

	@doc (
		summary:     "获取段位排行榜"
		description: "获取按排位分排序的用户排行榜，包含前三名和分页列表，公开接口无需登录"
	)
	@handler GetLeaderboard
	get /rank/leaderboard (GetLeaderboardReq) returns (GetLeaderboardResp)

	@doc (
		summary:     "获取公开对局详情"
		description: "获取对局详情（观战模式），公开接口无需登录，使用第三方视角"
	)
	@handler GetPublicMatchDetail
	get /match/detail (GetPublicMatchDetailReq) returns (GetPublicMatchDetailResp)
}

@server (
	prefix: /api/auth
	group:  auth
	jwt:    Auth
)
service chasing_points-api {
	@doc "绑定手机号"
	@handler BindPhone
	post /bind-phone (BindPhoneReq) returns (BindPhoneResp)
}

// ==================== 用户相关 ====================
// 更新昵称
type UpdateNicknameReq {
	Nickname string `json:"nickname"`
}

type UpdateNicknameResp {
	Success  bool      `json:"success"`
	Message  string    `json:"message"`
	UserInfo *UserInfo `json:"user_info"`
}

// 获取用户信息
type GetUserInfoResp {
	Success  bool      `json:"success"`
	UserInfo *UserInfo `json:"user_info"`
}

type FavoriteVenueRewardStatusResp {
	Success            bool   `json:"success"`
	Enabled            bool   `json:"enabled"`
	PopupEnabled       bool   `json:"popup_enabled"`
	RewardDays         int    `json:"reward_days"`
	NewUserWindowDays  int    `json:"new_user_window_days"`
	Status             string `json:"status"`
	MemberExpiresAt    string `json:"member_expires_at,optional"`
	SubmittedVenueId   int64  `json:"submitted_venue_id,optional"`
	SubmittedVenueName string `json:"submitted_venue_name,optional"`
	RejectReason       string `json:"reject_reason,optional"`
}

// 更新推送令牌
type UpdatePushTokenReq {
	PushClientId string `json:"push_client_id"`
}

// 用户统计数据
type UserStatsResp {
	Success      bool    `json:"success"`
	TotalMatches int     `json:"total_matches"` // 总对局数
	Wins         int     `json:"wins"` // 胜场数
	Losses       int     `json:"losses"` // 负场数
	WinRate      float64 `json:"win_rate"` // 胜率(百分比)
	MaxWinStreak int     `json:"max_win_streak"` // 最高连胜
}

@server (
	prefix: /api/user
	group:  user
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取当前用户信息"
	@handler GetUserInfo
	get /info returns (GetUserInfoResp)

	@doc "获取常玩球馆奖励状态"
	@handler GetFavoriteVenueRewardStatus
	get /favorite-venue-reward-status returns (FavoriteVenueRewardStatusResp)

	@doc "获取用户统计数据"
	@handler GetUserStats
	get /stats returns (UserStatsResp)

	@doc "更新昵称"
	@handler UpdateNickname
	post /nickname (UpdateNicknameReq) returns (UpdateNicknameResp)

	@doc "更新推送令牌"
	@handler UpdatePushToken
	post /push-token (UpdatePushTokenReq) returns (CommonResp)
}

// ==================== 对局相关 ====================
// 通用响应
type CommonResp {
	Success bool   `json:"success"`
	Message string `json:"message"`
}

// 特殊成绩项
type AchievementItem {
	Type  string `json:"type"`
	Count int    `json:"count"`
}

// 对局同步快照（当前登录用户视角）
type MatchSyncSnapshot {
	MatchId                       int64 `json:"match_id"`
	Status                        int   `json:"status"`
	ServerRevision                int64 `json:"server_revision"`
	MyScore                       int   `json:"my_score"`
	OpponentScore                 int   `json:"opponent_score"`
	CurrentFrameStarted           bool  `json:"current_frame_started,optional"`
	CurrentFrameMyScore           int   `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore     int   `json:"current_frame_opponent_score,optional"`
	CurrentRound                  int   `json:"current_round"`
	TotalRounds                   int   `json:"total_rounds"`
	RedBallCount                  int   `json:"red_ball_count,optional"`
	SnookerClearanceStarted       bool  `json:"snooker_clearance_started,optional"`
	SnookerClearedColors          []int `json:"snooker_cleared_colors,optional"`
	SnookerExpectedClearanceScore int   `json:"snooker_expected_clearance_score,optional"`
	SnookerClearanceCompleted     bool  `json:"snooker_clearance_completed,optional"`
}

// 开始对局
type StartMatchReq {
	GameType       int    `json:"game_type"` // 1=斯诺克 2=九球追分 3=中式八球 4=美式九球
	GameMode       string `json:"game_mode,optional"` // 比赛模式
	OpponentId     int64  `json:"opponent_id,optional"` // 对手ID
	OpponentName   string `json:"opponent_name"` // 对手昵称
	OpponentAvatar string `json:"opponent_avatar,optional"` // 对手头像
}

type StartMatchResp {
	Success      bool              `json:"success"`
	Action       string            `json:"action,optional"` // created/resume_existing/blocked
	BlockReason  string            `json:"block_reason,optional"` // self_ongoing/opponent_ongoing
	Message      string            `json:"message,optional"`
	MatchId      int64             `json:"match_id"`
	OngoingMatch *CurrentMatchInfo `json:"ongoing_match,optional"`
}

// 加分
type MatchScoreReq {
	MatchId        int64  `json:"match_id"`
	Actor          int    `json:"actor"` // 1=我 2=对手
	Score          int    `json:"score"` // 加的分数
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type MatchScoreResp {
	Accepted                      bool              `json:"accepted"`
	Success                       bool              `json:"success"`
	Message                       string            `json:"message,optional"`
	ClientActionId                string            `json:"client_action_id,optional"`
	ServerRevision                int64             `json:"server_revision"`
	Snapshot                      MatchSyncSnapshot `json:"snapshot"`
	RedBallCount                  int               `json:"red_ball_count,optional"`
	SnookerClearanceStarted       bool              `json:"snooker_clearance_started,optional"`
	SnookerClearedColors          []int             `json:"snooker_cleared_colors,optional"`
	SnookerExpectedClearanceScore int               `json:"snooker_expected_clearance_score,optional"`
	SnookerClearanceCompleted     bool              `json:"snooker_clearance_completed,optional"`
	CurrentFrameStarted           bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore           int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore     int               `json:"current_frame_opponent_score,optional"`
	MyScore                       int               `json:"my_score"`
	OpponentScore                 int               `json:"opponent_score"`
}

// 结束一局
type EndRoundReq {
	MatchId        int64  `json:"match_id"`
	Winner         int    `json:"winner"` // 1=我 2=对手
	WinType        string `json:"win_type,optional"` // 获胜方式
	Score          int    `json:"score,optional,default=1"` // 获胜得分，默认1分
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type EndRoundResp {
	Accepted                  bool              `json:"accepted"`
	Success                   bool              `json:"success"`
	ClientActionId            string            `json:"client_action_id,optional"`
	ServerRevision            int64             `json:"server_revision"`
	Snapshot                  MatchSyncSnapshot `json:"snapshot"`
	RoundNo                   int               `json:"round_no"`
	CurrentFrameStarted       bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore       int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore int               `json:"current_frame_opponent_score,optional"`
	MyScore                   int               `json:"my_score"`
	OpponentScore             int               `json:"opponent_score"`
}

// 开始下一局
type StartNextRoundReq {
	MatchId        int64  `json:"match_id"`
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type StartNextRoundResp {
	Accepted                  bool              `json:"accepted"`
	Success                   bool              `json:"success"`
	ClientActionId            string            `json:"client_action_id,optional"`
	ServerRevision            int64             `json:"server_revision"`
	Snapshot                  MatchSyncSnapshot `json:"snapshot"`
	RoundNo                   int               `json:"round_no"` // 新局数
	CurrentFrameStarted       bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore       int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore int               `json:"current_frame_opponent_score,optional"`
	MyScore                   int               `json:"my_score"` // 我方总分
	OpponentScore             int               `json:"opponent_score"` // 对手总分
}

// 犯规
type MatchFoulReq {
	MatchId        int64  `json:"match_id"`
	Actor          int    `json:"actor"` // 犯规方
	Score          int    `json:"score,optional"` // 犯规加分，默认1
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

// 撤销
type MatchUndoReq {
	MatchId        int64  `json:"match_id"`
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type MatchUndoResp {
	Accepted                  bool              `json:"accepted"`
	Success                   bool              `json:"success"`
	ClientActionId            string            `json:"client_action_id,optional"`
	ServerRevision            int64             `json:"server_revision"`
	Snapshot                  MatchSyncSnapshot `json:"snapshot"`
	CurrentFrameStarted       bool              `json:"current_frame_started,optional"`
	CurrentFrameMyScore       int               `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore int               `json:"current_frame_opponent_score,optional"`
	MyScore                   int               `json:"my_score"`
	OpponentScore             int               `json:"opponent_score"`
	Message                   string            `json:"message"`
}

// 结束对局
type FinishMatchReq {
	MatchId        int64  `json:"match_id"`
	Remark         string `json:"remark,optional"`
	ClientActionId string `json:"client_action_id"`
	BaseRevision   int64  `json:"base_revision"`
}

type FinishMatchResp {
	Accepted       bool              `json:"accepted"`
	Success        bool              `json:"success"`
	Result         int               `json:"result"` // 1=胜利 2=失败 3=平局
	ClientActionId string            `json:"client_action_id,optional"`
	ServerRevision int64             `json:"server_revision"`
	Snapshot       MatchSyncSnapshot `json:"snapshot"`
	MyScore        int               `json:"my_score"`
	OpponentScore  int               `json:"opponent_score"`
}

// 取消对局
type CancelMatchReq {
	MatchId int64 `json:"match_id"`
}

// 获取进行中对局
type CurrentMatchInfo {
	Id                        int64  `json:"id"`
	GameType                  int    `json:"game_type"`
	GameTypeName              string `json:"game_type_name"`
	GameMode                  string `json:"game_mode"`
	OpponentId                int64  `json:"opponent_id,optional"`
	OpponentName              string `json:"opponent_name"`
	OpponentAvatar            string `json:"opponent_avatar,optional"`
	MyScore                   int    `json:"my_score"`
	OpponentScore             int    `json:"opponent_score"`
	CurrentFrameStarted       bool   `json:"current_frame_started,optional"`
	CurrentFrameMyScore       int    `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore int    `json:"current_frame_opponent_score,optional"`
	CurrentRound              int    `json:"current_round"`
	ServerRevision            int64  `json:"server_revision"`
	MatchTime                 string `json:"match_time"`
	DurationSeconds           int64  `json:"duration_seconds"` // 对局已持续秒数
}

type GetCurrentMatchResp {
	Success bool              `json:"success"`
	Match   *CurrentMatchInfo `json:"match"`
}

// 对局列表
type MatchListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
	GameType int `form:"game_type,optional"`
	Result   int `form:"result,optional"`
}

type MatchListItem {
	Id             int64  `json:"id"`
	OpponentId     int64  `json:"opponent_id"` // 对手ID（注册用户才有）
	GameType       int    `json:"game_type"`
	GameTypeName   string `json:"game_type_name"`
	OpponentName   string `json:"opponent_name"`
	OpponentAvatar string `json:"opponent_avatar"`
	MyScore        int    `json:"my_score"`
	OpponentScore  int    `json:"opponent_score"`
	Result         int    `json:"result"`
	MatchTime      string `json:"match_time"`
}

type MatchListResp {
	Success bool            `json:"success"`
	Total   int64           `json:"total"`
	List    []MatchListItem `json:"list"`
}

// 交锋统计
type H2HStatsReq {
	OpponentId   int64  `form:"opponent_id,optional"`
	OpponentName string `form:"opponent_name,optional"`
}

type H2HOpponent {
	Id     int64  `json:"id"`
	Name   string `json:"name"`
	Avatar string `json:"avatar"`
}

type H2HStats {
	TotalMatches int     `json:"total_matches"`
	MyWins       int     `json:"my_wins"`
	OpponentWins int     `json:"opponent_wins"`
	WinRate      float64 `json:"win_rate"`
	AvgScoreDiff float64 `json:"avg_score_diff"`
	MaxWinStreak int     `json:"max_win_streak"`
}

type H2HStatsResp {
	Success  bool         `json:"success"`
	Opponent *H2HOpponent `json:"opponent"`
	Stats    *H2HStats    `json:"stats"`
}

// 交锋历史
type H2HHistoryReq {
	OpponentId int64 `form:"opponent_id"`
	Page       int   `form:"page,default=1"`
	PageSize   int   `form:"page_size,default=20"`
	Result     int   `form:"result,optional"`
}

type H2HHistoryResp {
	Success bool            `json:"success"`
	Total   int64           `json:"total"`
	List    []MatchListItem `json:"list"`
}

// 搜索对手
type SearchOpponentReq {
	Keyword string `form:"keyword"`
}

type OpponentItem {
	Id         int64  `json:"id"`
	Name       string `json:"name"`
	Avatar     string `json:"avatar"`
	MatchCount int    `json:"match_count"`
}

type SearchOpponentResp {
	Success bool           `json:"success"`
	List    []OpponentItem `json:"list"`
}

// 获取匹配二维码
type GetMatchQRCodeResp {
	Success    bool   `json:"success"`
	QrcodeData string `json:"qrcode_data"` // 二维码内容JSON: {"user_id":xxx,"nickname":"xxx","avatar":"xxx","ts":xxx}
}

// 获取对局详情
type GetMatchDetailReq {
	MatchId int64 `form:"match_id"`
}

type MatchAchievement {
	BreakClear    int `json:"break_clear"` // 炸清次数
	ContinueClear int `json:"continue_clear"` // 接清次数
	GoldenBreak   int `json:"golden_break"` // 金球数
	NineOnBreak   int `json:"nine_on_break"` // 大金数
	Break50       int `json:"break_50"` // 单杆50+
	Break100      int `json:"break_100"` // 单杆100+
	Break147      int `json:"break_147"` // 单杆147
}

type RankDetail {
	Label string `json:"label"`
	Value int    `json:"value"`
}

type GetMatchDetailResp {
	Success bool            `json:"success"`
	Match   MatchDetailData `json:"match"`
}

type MatchSummaryItem {
	Label string `json:"label"`
	Value string `json:"value"`
	Desc  string `json:"desc,optional"`
	Icon  string `json:"icon,optional"`
	Tone  string `json:"tone,optional"`
}

type MatchDetailData {
	Id                            int64              `json:"id"`
	GameType                      int                `json:"game_type"`
	Status                        int                `json:"status"` // 1=进行中 2=已完成 3=已取消
	ServerRevision                int64              `json:"server_revision"`
	IsPlayer1                     bool               `json:"is_player1"` // 当前用户是否是创建者(用于视角判断)
	MyScore                       int                `json:"my_score"` // 从当前用户视角的分数
	OpponentScore                 int                `json:"opponent_score"` // 从当前用户视角的对手分数
	MyName                        string             `json:"my_name"`
	OpponentName                  string             `json:"opponent_name"`
	MyAvatar                      string             `json:"my_avatar"`
	OpponentAvatar                string             `json:"opponent_avatar"`
	MyWinRate                     float64            `json:"my_win_rate"` // 我方胜率(百分比)
	OpponentWinRate               float64            `json:"opponent_win_rate"` // 对手胜率(百分比)
	MyMaxScore                    int                `json:"my_max_score"` // 我方单杆最高
	OpponentMaxScore              int                `json:"opponent_max_score"` // 对手单杆最高
	MyRankChange                  int                `json:"my_rank_change"`
	OpponentRankChange            int                `json:"opponent_rank_change"`
	MyRankDetails                 []RankDetail       `json:"my_rank_details"`
	CurrentFrameStarted           bool               `json:"current_frame_started,optional"`
	CurrentFrameMyScore           int                `json:"current_frame_my_score,optional"`
	CurrentFrameOpponentScore     int                `json:"current_frame_opponent_score,optional"`
	RedBallCount                  int                `json:"red_ball_count,optional"`
	SnookerClearanceStarted       bool               `json:"snooker_clearance_started,optional"`
	SnookerClearedColors          []int              `json:"snooker_cleared_colors,optional"`
	SnookerExpectedClearanceScore int                `json:"snooker_expected_clearance_score,optional"`
	SnookerClearanceCompleted     bool               `json:"snooker_clearance_completed,optional"`
	SummaryHighlights             []MatchSummaryItem `json:"summary_highlights,optional"`
	SummaryStats                  []MatchSummaryItem `json:"summary_stats,optional"`
	Achievements                  MatchAchievement   `json:"achievements"`
	CreatedAt                     string             `json:"created_at"`
}

@server (
	prefix: /api/match
	group:  match
	jwt:    Auth
)
service chasing_points-api {
	@doc "开始对局"
	@handler StartMatch
	post /start (StartMatchReq) returns (StartMatchResp)

	@doc "加分"
	@handler MatchScore
	post /score (MatchScoreReq) returns (MatchScoreResp)

	@doc "结束一局"
	@handler EndRound
	post /round/end (EndRoundReq) returns (EndRoundResp)

	@doc "开始下一局"
	@handler StartNextRound
	post /round/start (StartNextRoundReq) returns (StartNextRoundResp)

	@doc "犯规"
	@handler MatchFoul
	post /foul (MatchFoulReq) returns (MatchScoreResp)

	@doc "撤销操作"
	@handler MatchUndo
	post /undo (MatchUndoReq) returns (MatchUndoResp)

	@doc "结束对局"
	@handler FinishMatch
	post /finish (FinishMatchReq) returns (FinishMatchResp)

	@doc "取消对局"
	@handler CancelMatch
	post /cancel (CancelMatchReq) returns (CommonResp)

	@doc "获取进行中对局"
	@handler GetCurrentMatch
	get /current returns (GetCurrentMatchResp)

	@doc "获取对局列表"
	@handler GetMatchList
	get /list (MatchListReq) returns (MatchListResp)

	@doc "获取交锋统计"
	@handler GetH2HStats
	get /h2h/stats (H2HStatsReq) returns (H2HStatsResp)

	@doc "获取交锋历史"
	@handler GetH2HHistory
	get /h2h/history (H2HHistoryReq) returns (H2HHistoryResp)

	@doc "获取匹配二维码"
	@handler GetMatchQRCode
	get /qrcode returns (GetMatchQRCodeResp)

	@doc "获取对局详情"
	@handler GetMatchDetail
	get /detail (GetMatchDetailReq) returns (GetMatchDetailResp)
}

// 对手记录列表项
type OpponentRecordItem {
	Id           int64   `json:"id"`
	Name         string  `json:"name"`
	Avatar       string  `json:"avatar"`
	TotalMatches int     `json:"total_matches"` // 总对局数
	Wins         int     `json:"wins"` // 我方胜场
	Losses       int     `json:"losses"` // 我方负场
	WinRate      float64 `json:"win_rate"` // 胜率百分比
	LastMatchAt  string  `json:"last_match_at"` // 上次对局时间
}

// 获取对手列表请求
type GetOpponentListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Keyword  string `form:"keyword,optional"`
}

// 获取对手列表响应
type GetOpponentListResp {
	Success        bool                 `json:"success"`
	TotalOpponents int                  `json:"total_opponents"` // 总对手数
	TotalWins      int                  `json:"total_wins"` // 总胜场
	Total          int64                `json:"total"`
	List           []OpponentRecordItem `json:"list"`
}

@server (
	prefix: /api/opponent
	group:  opponent
	jwt:    Auth
)
service chasing_points-api {
	@doc "搜索对手"
	@handler SearchOpponent
	get /search (SearchOpponentReq) returns (SearchOpponentResp)

	@doc (
		summary:     "获取对手列表"
		description: "获取当前用户交战过的所有对手列表及统计数据"
	)
	@handler GetOpponentList
	get /list (GetOpponentListReq) returns (GetOpponentListResp)
}

// ==================== 段位相关 ====================
// 段位信息
type RankInfo {
	Level       int    `json:"level"` // 段位等级 1-5
	Name        string `json:"name"` // 段位名称
	Icon        string `json:"icon"` // 段位图标URL
	RankScore   int    `json:"rank_score"` // 当前排位分
	TotalWins   int    `json:"total_wins"` // 总胜场
	TotalLosses int    `json:"total_losses"` // 总败场
	MaxStreak   int    `json:"max_streak"` // 最高连胜
	NextLevel   int    `json:"next_level"` // 下一段位等级
	NextName    string `json:"next_name"` // 下一段位名称
	NextScore   int    `json:"next_score"` // 晋级所需分数
	Progress    int    `json:"progress"` // 晋级进度百分比
}

// 获取用户段位信息
type GetUserRankInfoReq {
	GameType int `form:"game_type,optional,default=3"`
}

type GetUserRankInfoResp {
	Success  bool      `json:"success"`
	RankInfo *RankInfo `json:"rank_info"`
}

// 段位列表项
type RankItem {
	Level     int    `json:"level"`
	Name      string `json:"name"`
	Icon      string `json:"icon"`
	MinScore  int    `json:"min_score"` // 晋升最低分
	IsCurrent bool   `json:"is_current"` // 是否当前段位
}

// 获取段位列表
type GetRankListReq {
	GameType int `form:"game_type,optional,default=3"`
}

type GetRankListResp {
	Success bool       `json:"success"`
	List    []RankItem `json:"list"`
}

// 排行榜用户项
type LeaderboardItem {
	Rank      int    `json:"rank"` // 排名
	UserId    int64  `json:"user_id"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar"`
	RankLevel int    `json:"rank_level"` // 段位等级
	RankName  string `json:"rank_name"` // 段位名称
	RankScore int    `json:"rank_score"` // 排位分
	WinRate   int    `json:"win_rate"` // 胜率百分比
}

// 获取排行榜请求
type GetLeaderboardReq {
	GameType int `form:"game_type,optional,default=3"`
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=20"`
}

// 获取排行榜响应
type GetLeaderboardResp {
	Success   bool              `json:"success"`
	Total     int64             `json:"total"`
	TopThree  []LeaderboardItem `json:"top_three"` // 前三名
	MyRanking *LeaderboardItem  `json:"my_ranking"` // 我的排名
	List      []LeaderboardItem `json:"list"` // 第4名开始的列表
}

@server (
	prefix: /api/rank
	group:  rank
	jwt:    Auth
)
service chasing_points-api {
	@doc (
		summary:     "获取用户段位信息"
		description: "获取当前登录用户的段位信息，包括段位等级、排位分和晋级进度"
	)
	@handler GetUserRankInfo
	get /info (GetUserRankInfoReq) returns (GetUserRankInfoResp)

	@doc (
		summary:     "获取段位列表"
		description: "获取所有段位列表及其晋升条件"
	)
	@handler GetRankList
	get /list (GetRankListReq) returns (GetRankListResp)
}

