}

// ==================== 球馆模块 ====================
type VenueInfo {
	Id            int64    `json:"id"`
	Name          string   `json:"name"`
	Address       string   `json:"address"`
	City          string   `json:"city"`
	District      string   `json:"district"`
	Latitude      float64  `json:"latitude"`
	Longitude     float64  `json:"longitude"`
	Phone         string   `json:"phone"`
	Images        []string `json:"images"`
	BusinessHours string   `json:"business_hours"`
	TableCount    int      `json:"table_count"`
	PriceRange    string   `json:"price_range"`
	Description   string   `json:"description"`
	Distance      float64  `json:"distance,omitempty"`
	CheckinCount  int      `json:"checkin_count"`
	Status        int      `json:"status"`
}

type GetVenueListReq {
	Page      int     `form:"page,default=1"`
	PageSize  int     `form:"page_size,default=20"`
	City      string  `form:"city,optional"`
	Latitude  float64 `form:"latitude,optional"`
	Longitude float64 `form:"longitude,optional"`
	SortBy    string  `form:"sort_by,optional,default=distance"`
}

type GetVenueListResp {
	Success bool        `json:"success"`
	Total   int64       `json:"total"`
	List    []VenueInfo `json:"list"`
}

type GetVenueDetailReq {
	VenueId int64 `form:"venue_id"`
}

type GetVenueDetailResp {
	Success bool       `json:"success"`
	Venue   *VenueInfo `json:"venue"`
}

type GetNearbyVenuesReq {
	Latitude  float64 `form:"latitude"`
	Longitude float64 `form:"longitude"`
	Radius    int     `form:"radius,optional,default=5000"`
	Limit     int     `form:"limit,optional,default=10"`
}

type VenueAreaOption {
	AreaId   int64  `json:"area_id"`
	ParentId int64  `json:"parent_id"`
	Name     string `json:"name"`
}

type GetVenueAreaOptionsReq {
	ParentId int64 `form:"parent_id,optional,default=0"`
}

type GetVenueAreaOptionsResp {
	Success bool              `json:"success"`
	List    []VenueAreaOption `json:"list"`
}

// 球馆公开接口
@server (
	prefix: /api/venue
	group:  venue
)
service chasing_points-api {
	@doc "获取球馆列表"
	@handler GetVenueList
	get /list (GetVenueListReq) returns (GetVenueListResp)

	@doc "获取球馆详情"
	@handler GetVenueDetail
	get /detail (GetVenueDetailReq) returns (GetVenueDetailResp)

	@doc "获取附近球馆"
	@handler GetNearbyVenues
	get /nearby (GetNearbyVenuesReq) returns (GetVenueListResp)

	@doc "获取地区选项"
	@handler GetVenueAreaOptions
	get /areas (GetVenueAreaOptionsReq) returns (GetVenueAreaOptionsResp)
}

// 球馆需登录接口
