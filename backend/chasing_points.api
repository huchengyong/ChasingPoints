	Success bool `json:"success"`
	Count   int  `json:"count"`
}

@server (
	prefix: /api/notification
	group:  notification
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取通知列表"
	@handler GetNotificationList
	get /list (GetNotificationListReq) returns (GetNotificationListResp)

	@doc "标记已读"
	@handler MarkNotificationRead
	post /read (NotificationIdReq) returns (CommonResp)

	@doc "全部标记已读"
	@handler MarkAllNotificationsRead
