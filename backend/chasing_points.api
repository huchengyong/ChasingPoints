	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=20"`
	Type     string `form:"type,optional"`
}

type GetNotificationListResp {
	Success bool               `json:"success"`
	Total   int64              `json:"total"`
	List    []NotificationInfo `json:"list"`
}

type NotificationIdReq {
	NotificationId int64 `json:"notification_id"`
}

type GetUnreadCountResp {
	Success bool `json:"success"`
	Count   int  `json:"count"`
}

type NotificationPreferencesResp {
	Success              bool `json:"success"`
	MatchResultEnabled   bool `json:"match_result_enabled"`
	FriendRequestEnabled bool `json:"friend_request_enabled"`
	ChallengeEnabled     bool `json:"challenge_enabled"`
	TournamentEnabled    bool `json:"tournament_enabled"`
	FollowEnabled        bool `json:"follow_enabled"`
}

type SaveNotificationPreferencesReq {
	MatchResultEnabled   bool `json:"match_result_enabled"`
	FriendRequestEnabled bool `json:"friend_request_enabled"`
	ChallengeEnabled     bool `json:"challenge_enabled"`
	TournamentEnabled    bool `json:"tournament_enabled"`
	FollowEnabled        bool `json:"follow_enabled"`
}

@server (
	prefix: /api/notification
	group:  notification
	jwt:    Auth
)
service chasing_points-api {
	@doc "获取通知列表"
	@handler GetNotificationList
	get /list (GetNotificationListReq) returns (GetNotificationListResp)

	@doc "标记已读"
	@handler MarkNotificationRead
	post /read (NotificationIdReq) returns (CommonResp)

	@doc "全部标记已读"
	@handler MarkAllNotificationsRead
	post /read-all returns (CommonResp)

	@doc "获取未读数量"
	@handler GetUnreadCount
	get /unread-count returns (GetUnreadCountResp)

	@doc "获取通知偏好"
	@handler GetNotificationPreferences
	get /preferences returns (NotificationPreferencesResp)

	@doc "保存通知偏好"
	@handler SaveNotificationPreferences
	post /preferences (SaveNotificationPreferencesReq) returns (NotificationPreferencesResp)

	@doc "删除通知"
	@handler DeleteNotification
	post /delete (NotificationIdReq) returns (CommonResp)
}

// ==================== 分享模块 ====================
type GetMatchShareDataReq {
	MatchId int64 `form:"match_id"`
}

type MatchShareData {
	MatchId           int64              `json:"match_id"`
	GameType          int                `json:"game_type"`
	GameTypeName      string             `json:"game_type_name"`
	MyName            string             `json:"my_name"`
	MyAvatar          string             `json:"my_avatar"`
	MyScore           int                `json:"my_score"`
	OpponentName      string             `json:"opponent_name"`
	OpponentAvatar    string             `json:"opponent_avatar"`
	OpponentScore     int                `json:"opponent_score"`
	Result            string             `json:"result"`
	MatchTime         string             `json:"match_time"`
	RankChange        int                `json:"rank_change"`
	SummaryHighlights []MatchSummaryItem `json:"summary_highlights,optional"`
	SummaryStats      []MatchSummaryItem `json:"summary_stats,optional"`
}

type GetMatchShareDataResp {
	Success bool            `json:"success"`
	Data    *MatchShareData `json:"data"`
}

type GetTournamentShareDataReq {
	TournamentId int64 `form:"tournament_id"`
}

type TournamentShareData {
	TournamentId   int64  `json:"tournament_id"`
	TournamentName string `json:"tournament_name"`
	FinalRank      int    `json:"final_rank"`
	TotalPlayers   int    `json:"total_players"`
	MatchesPlayed  int    `json:"matches_played"`
	MatchesWon     int    `json:"matches_won"`
}

type GetTournamentShareDataResp {
	Success bool                 `json:"success"`
