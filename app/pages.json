{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/welcome/index",
			"style": {
				"navigationBarTitleText": "欢迎",
				"navigationStyle": "custom",
				"navigationBarTextStyle": "white"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom",
				"navigationBarTextStyle": "white",
				"backgroundColor": "@background"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "追分",
				"navigationBarBackgroundColor": "@background"
			}
		},
		{
			"path": "pages/match/index",
			"style": {
				"navigationBarTitleText": "观赛",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/social/index",
			"style": {
				"navigationBarTitleText": "赛讯"
			}
		},
			{
				"path": "pages/user/index",
				"style": {
					"navigationBarTitleText": "我的"
				}
			}
	],
	"tabBar": {
		"color": "@tabInactive",
		"selectedColor": "@tabActive",
		"backgroundColor": "@background",
		"borderStyle": "@tabBarBorderStyle",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "@indexIconPath",
				"selectedIconPath": "@selectedIndexIconPath"
			},
			{
				"pagePath": "pages/match/index",
				"text": "观赛",
				"iconPath": "@matchIconPath",
				"selectedIconPath": "@selectedMatchIconPath"
			},
			{
				"pagePath": "pages/social/index",
				"text": "赛讯",
				"iconPath": "@socialIconPath",
				"selectedIconPath": "@selectedSocialIconPath"
			},
			{
				"pagePath": "pages/user/index",
				"text": "我的",
				"iconPath": "@userIconPath",
				"selectedIconPath": "@selectedUserIconPath"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "@navigationBarTextStyle",
		"navigationBarTitleText": "追分",
		"navigationBarBackgroundColor": "@background",
		"backgroundColor": "@background",
		"backgroundTextStyle": "@backgroundTextStyle"
	},
